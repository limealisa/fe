<%- include('../../includes/header') %>
    <div id="elementModal"> </div>
    <div class="container-fluid">
        <!-- -------------------------------------------------------------- -->
        <!-- Start Page Content -->
        <!-- -------------------------------------------------------------- -->
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header border-bottom title-part-padding d-flex align-items-center">
                        <h4 class="card-title"><%=dataPage.title%></h4>
                        <div class="card-actions ms-auto d-flex button-group">
                          <a class="mb-0 btn-minimize link d-flex align-items-center" data-action="expand">
                            <i class="ri-fullscreen-line fs-6"></i>
                          </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <form action="" method="get" class="form-body row">
                                <div class="col-md-12 row" style="margin-bottom:10px;">
                                    <div class="col-md-2 row" style="margin-bottom: 10px;">
                                        <div class="input-group">
                                            <input type="text" name="from" class="form-control mydatepicker"
                                                placeholder="mm/dd/yyyy">
                                            <span class="input-group-text">
                                                <i class="fas fa-calendar-alt"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-2 row" style="margin-bottom: 10px;">
                                        <div class="input-group">
                                            <input type="text" name="to" class="form-control mydatepicker"
                                                placeholder="mm/dd/yyyy">
                                            <span class="input-group-text">
                                                <i class="fas fa-calendar-alt"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-1 row">
                                        <button type="submit" type="button" class="btn waves-effect waves-light btn-secondary"
                                            style="height: 30px;margin-top: 2px;">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </div>
                                    <div class="row col-md-7 justify-content-end">
                                        <div class="col-md-2 ml-auto">
                                            <div class="thongke-text">
                                                Số lượng tổng: <o id="total-bet"><%=dataPage.helpers.numberWithCommas(dataApi.dataCount.totalAmount);%></o>
                                            </div>
                                        </div>
                                        <div class="col-md-2 ml-auto">
                                            <div class="thongke-text">
                                                Thành công: <o id="total-bet-valid"><%=dataPage.helpers.numberWithCommas(dataApi.dataCount.totalSuccess);%></o>
                                            </div>
                                        </div>
                                        <div class="col-md-2 ml-auto">
                                            <div class="thongke-text">
                                                Thất bại: <o id="total-profit"><%=dataPage.helpers.numberWithCommas(dataApi.dataCount.totalFail);%></o>
                                            </div>
                                        </div>
                                        <div class="col-md-2 ml-auto">
                                            <div class="thongke-text">
                                                Chờ duyệt: <o id="total-profit"><%=dataPage.helpers.numberWithCommas(dataApi.dataCount.totalPending);%></o>
                                            </div>
                                        </div>              
                                    </div>
                                </div>
                                <div class="col-lg-10 row">
                                    <div class="col-md-2">
                                        <div class="input-group mb-3">
                                            <span class="input-group-text" id="basic-addon1">Bank rút</span>
                                            <input type="text" class="form-control" name="bankProvide"
                                                placeholder="VIETCOMBANK..." aria-describedby="basic-addon1">
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="input-group mb-3">
                                            <span class="input-group-text" id="basic-addon1">Người rút</span>
                                            <input type="text" class="form-control" name="bankName"
                                                placeholder="NGUYEN VAN A..." aria-describedby="basic-addon1">
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="input-group mb-3">
                                            <span class="input-group-text" id="basic-addon1">STK rút</span>
                                            <input type="text" class="form-control" name="bankNumber"
                                                placeholder="107866899291..." aria-describedby="basic-addon1">
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="input-group mb-3">
                                            <span class="input-group-text" id="basic-addon1">Mã Giao Dịch</span>
                                            <input type="text" class="form-control" name="transId"
                                                placeholder="51312723..." aria-describedby="basic-addon1">
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="input-group mb-3">
                                            <span class="input-group-text" id="basic-addon1">Số Tiền</span>
                                            <input type="text" class="form-control" name="amount" placeholder="50000..."
                                                aria-describedby="basic-addon1">
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="input-group mb-3">
                                            <span class="input-group-text" id="basic-addon1">Trạng thái</span>
                                            <select class="form-control form-select" name="status"
                                                data-placeholder="Choose a Category" tabindex="1"
                                                aria-describedby="basic-addon1">
                                                <option value="">Tất Cả</option>
                                                <option value="pending">Chờ Duyệt</option>
                                                <option value="success">Thành Công</option>
                                                <option value="error">Thất Bại</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-info align-items-center">
                                        <i class="fa fa-search"></i> Tìm kiếm
                                    </button>
                                    <button type="button" class="btn btn-info align-items-center">
                                        <i class="fa fa-users"></i> Tổng: <%=dataApi.total%>
                                    </button>
                                </div>
                            </form>
                        </div>
                        <div class="table-responsive">
                            <table id="table-container" class="table customize-table table-bordered mb-10 v-middle">
                                <thead class="bg-primary text-white">
                                    <tr>
                                        <th>#OrderID</th>
                                        <th>Tên Đăng Nhập</th>
                                        <th>Số Tiền Rút</th>
                                        <th>Ngân Hàng Rút</th>
                                        <th>Số Tài Khoản Rút</th>
                                        <th>Người Rút</th>
                                        <th>Mã Giao Dịch</th>
                                        <th>Trạng Thái</th>
                                        <th>Ngày Tạo</th>
                                        <th>Thông Tin Thêm</th>
                                        <th class="text-center">Hành Động</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if(dataApi.dataExport.length> 0) { %>

                                        <% dataApi.dataExport.forEach((data)=> { %>
                                            <tr>
                                                <td>
                                                    #<%=data.id%>
                                                </td>
                                                <td>
                                                    <%=data.userInfo.username%>
                                                </td>
                                                <td>
                                                    <%=dataPage.helpers.numberWithCommas(data.amount)%> VND
                                                </td>
                                                <td>
                                                    <%=data.bankProvide%>
                                                </td>
                                                <td>
                                                    <%=data.bankNumber%>
                                                </td>
                                                <td>
                                                    <%=data.bankName%>
                                                </td>
                                                <td>
                                                    <%=data.transId%>
                                                </td>
                                                <td>
                                                    <% if(data.status == "pending") { %>
                                                        Chờ duyệt
                                                    <% }else if(data.status == "success") { %>
                                                        Thành công
                                                    <% }else if(data.status == "error") { %>
                                                        Thất bại
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <%= dataPage.helpers.moment(data.createdAt).format("HH:mm DD/MM/YYYY") %>
                                                </td>
                                                <td>
                                                    <%=data.info%>
                                                </td>
                                                <td class="text-center">
                                                    <button style="margin-left: 10px;"
                                                        onclick="showFormUpdateRecord('<%=data.id%>')"
                                                        class="btn btn-sm waves-effect waves-light btn-primary">
                                                        <span class="btn-icon-left"> <b><i
                                                                    class="fa fa-pencil color-dark"></i></b>
                                                        </span>
                                                    </button>
                                                    <button style="margin-left: 10px;"
                                                        onclick="deleteDailyConfirm('<%=data.id%>')" type="button"
                                                        class="btn btn-sm waves-effect waves-light btn-danger"><span
                                                            class="btn-icon-left">
                                                            <b><i class="fa fa-trash color-dark"></i></b>
                                                        </span>
                                                    </button>
                                                </td>
                                            </tr>
                                            <% }); %>
                                                <% } %>
                                </tbody>
                            </table>
                        </div>
                        <div class="bootstrap-pagination">
                            <nav>
                                <ul class="pagination justify-content-center" id="phantrangUser"></ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <!-- row -->
        <!-- -------------------------------------------------------------- -->
        <!-- End PAge Content -->
        <!-- -------------------------------------------------------------- -->
    </div>
    <script>
        $(document).ready(() => {
            $('#table-container').DataTable({
                paging: false,
                searching: false,
                info: false,
                order: [[0, 'desc']],
            });
            const urlParams = new URLSearchParams(window.location.search);
            $('input[name="from"]').val(urlParams.get('from') ? urlParams.get('from') : moment().format("DD/MM/YYYY"));
            $('input[name="to"]').val(urlParams.get('to') ? urlParams.get('to') : moment().format("DD/MM/YYYY"));
    
            // Date Picker  
            $('input[name="from"]').datepicker({
                language: 'vi',
                autoclose: true,
                todayHighlight: true,
            });
            $('input[name="to"]').datepicker({
                language: 'vi',
                autoclose: true,
                todayHighlight: true,
            });
        });

        const phantrang = Pagination('<%=dataApi.page%>', '<%=dataApi.total%>', '<%=dataApi.kmess%>');
        const urlSearchParams = new URLSearchParams(window.location.search);
        urlSearchParams.delete("page");
        urlSearchParams.delete("limit");
        let phantrangBody = '';
        phantrang.forEach((page) => {
            $("#phantrangUser").html(phantrangBody);
            let active = ('<%=dataApi.page%>' == page) ? "active" : "";
            const urlToPage = (page !== "...") ? `/withdraw?page=${page}&limit=<%=dataApi.kmess%>&${urlSearchParams.toString()}` : `javascript:void(0)`;
            phantrangBody += `
                <li class="page-item ${active}">
                    <a class="page-link" href="${urlToPage}"><b>${page}</b></a>
                </li>
            `;
            $("#phantrangUser").html(phantrangBody);
        });

        const deleteDailyConfirm = (id) => {
            cuteAlert({
                type: "question",
                title: "Hành Động",
                message: "Bạn có muốn xóa nó không?",
                confirmText: "Đồng ý",
                cancelText: "Hủy"
            }).then((e) => {
                if (e == 'confirm') {
                    $.ajax({
                        "url": '<%=dataPage.config.API_SERVER%>/user/delete/' + id,
                        "method": "GET",
                        "timeout": 0,
                        "headers": {
                            "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                        },
                    }).then((response) => {
                        if (response.status) {
                            toastr.success(
                                "Thành công.",
                                "Success!"
                            );
                            setTimeout(() => {
                                window.location = "";
                            }, 700);
                        } else {
                            toastr.error(
                                response.msg,
                                "Error!"
                            );
                        }
                    }).catch((err) => {
                        console.log(err);
                        toastr.error(
                            err.responseJSON.msg,
                            "Error!"
                        );
                    });

                }
            });
        }

        const showFormUpdateRecord = (id) => {
            $.ajax({
                "url": '<%=dataPage.config.API_SERVER%>/withdraw/withdraw-info/' + id,
                "method": "GET",
                "timeout": 0,
                "headers": {
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                },
            }).then((response) => {
                if (response.status) {
                    $('#elementModal').html(`
                    <div class="modal fade" id="depositInfo-update-modal" tabindex="-1" aria-labelledby="exampleModalLabel1">
                        <div class="modal-dialog modal-sm" role="document">
                            <div class="modal-content">
                                <div class="modal-header d-flex align-items-center">
                                    <h4 class="modal-title" id="exampleModalLabel1">
                                        Cập nhật yêu cầu rút tiền
                                    </h4>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <form>
                                        <div class="mb-3">
                                            <label for="recipient-name" class="control-label">Tên người chơi:</label>
                                            <input type="text" class="form-control" id="update-username" readonly />
                                        </div>
                                        <div class="mb-3">
                                            <label for="recipient-name" class="control-label">Số dư hiện tại:</label>
                                            <input type="number" class="form-control" id="update-coin" readonly />
                                        </div>
                                        <div class="mb-3">
                                            <label for="recipient-name" class="control-label">Số tiền rút:</label>
                                            <input type="number" class="form-control" id="update-amount" readonly />
                                        </div>
                                        <div class="mb-3">
                                            <label for="recipient-name" class="control-label">Ngân hàng rút về:</label>
                                            <input type="text" class="form-control" id="update-bankProvide" readonly />
                                        </div>
                                        <div class="mb-3">
                                            <label for="recipient-name" class="control-label">Số tài khoản rút về:</label>
                                            <input type="text" class="form-control" id="update-bankNumber" readonly />
                                        </div>
                                        <div class="mb-3">
                                            <label for="recipient-name" class="control-label">Chủ tài khoản rút về:</label>
                                            <input type="text" class="form-control" id="update-bankName" readonly />
                                        </div>
                                        <div class="mb-3">
                                            <label for="recipient-name" class="control-label">Trạng thái yêu cầu:</label>
                                            <select class="form-control form-select" id="update-status"></select>
                                        </div>
                                    </form>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="
                        btn btn-light-danger
                        text-danger
                        font-weight-medium
                        " data-bs-dismiss="modal">
                                        Close
                                    </button>
                                    <button type="button" class="btn btn-success" onclick="updateWithdraw('${id}')">
                                        Cập nhật
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    `);

                    $('#update-username').val(response.data.userInfo.username);
                    $('#update-coin').val(numberWithCommas(response.data.userInfo.coin));
                    $('#update-amount').val(response.data.amount);
                    $('#update-bankProvide').val(response.data.bankProvide);
                    $('#update-bankName').val(response.data.bankName);
                    $('#update-bankNumber').val(response.data.bankNumber);


                    if (response.data.status == "success") {
                        $('#update-status').append(`<option value="success">Thành công</option>`);
                        $('#update-status').append(`<option value="pending">Chờ duyệt</option>`);
                        $('#update-status').append(`<option value="error">Thất bại</option>`);
                    } else if (response.data.status == "pending") {
                        $('#update-status').append(`<option value="pending">Chờ duyệt</option>`);
                        $('#update-status').append(`<option value="success">Thành công</option>`);
                        $('#update-status').append(`<option value="error">Thất bại</option>`);
                    } else if (response.data.status == "error") {
                        $('#update-status').append(`<option value="error">Thất bại</option>`);
                        $('#update-status').append(`<option value="pending">Chờ duyệt</option>`);
                        $('#update-status').append(`<option value="success">Thành công</option>`);
                    }
                    $('#depositInfo-update-modal').modal('toggle');
                } else {
                    toastr.error(
                        response.msg,
                        "Error!"
                    );
                }
            }).catch((err) => {
                console.log(err);
                toastr.error(
                    err.responseJSON.msg,
                    "Error!"
                );
            });
        }

        const updateWithdraw = (id) => {
            const status = $('#update-status').val();

            $.ajax({
                "url": "<%=dataPage.config.API_SERVER%>/withdraw/update/" + id,
                "method": "POST",
                "timeout": 0,
                "headers": {
                    "Content-Type": "application/json",
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                },
                "data": JSON.stringify({
                    status
                }),
            }).done(function (response) {
                if (response.status) {
                    toastr.success(
                        response.msg,
                        "Success!"
                    );
                    setTimeout(() => {
                        window.location = "";
                    }, 700);
                } else {
                    toastr.error(
                        response.msg,
                        "Error!"
                    );
                }
            });
        }
    </script>
    <%- include('../../includes/footer') %>