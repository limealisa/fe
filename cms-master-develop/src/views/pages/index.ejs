    <script>


        $(document).ready(() => {
            // Set default value
            $('input[name="inputDashboardFrom"]').val(moment().format("DD/MM/YYYY"));
            $('input[name="inputDashboardTo"]').val(moment().format("DD/MM/YYYY"));

            // Date Picker  
            $('input[name="inputDashboardFrom"]').datepicker({
                language: 'vi',
                autoclose: true,
                todayHighlight: true,
            });
            $('input[name="inputDashboardTo"]').datepicker({
                language: 'vi',
                autoclose: true,
                todayHighlight: true,
            });

            // call system statis
            getStatisSystem();
            // call system caculate
            getCalculateSystem();
            // call sum user and agency sum balance
            getTotalSumBalance();

            // Set default value
            $('input[name="inputDashboardChartFrom"]').val(moment().subtract(7, 'days').format("DD/MM/YYYY"));
            $('input[name="inputDashboardChartTo"]').val(moment().format("DD/MM/YYYY"));

            // Date Picker  
            $('input[name="inputDashboardChartFrom"]').datepicker({
                language: 'vi',
                autoclose: true,
                todayHighlight: true,
            });
            $('input[name="inputDashboardChartTo"]').datepicker({
                language: 'vi',
                autoclose: true,
                todayHighlight: true,
            });

            // call system statis
            getStatisChart();
        });
        // getStatisChart

        const getStatisChart = () => {
            blockUI(true);
            $.ajax({
                "url": '<%=dataPage.config.API_SERVER%>/dashboard/chart-statis?from=' + $('input[name="inputDashboardChartFrom"]').val() + '&to=' + $('input[name="inputDashboardChartTo"]').val(),
                "method": "GET",
                "timeout": 0,
                "headers": { "Authorization": "Bearer <%=dataPage.session.accessToken%>", },
            }).then((response) => {
                blockUI(false);
                if (response.status) {
                    initChartStatis(response.data.chart);
                } else {
                    toastr.error(
                        response.msg,
                        "Error!"
                    );
                }
            });
        }

        const getStatisSystem = () => {
            blockUI(true);
            $.ajax({
                "url": '<%=dataPage.config.API_SERVER%>/dashboard/statis?from=' + $('input[name="inputDashboardFrom"]').val() + '&to=' + $('input[name="inputDashboardTo"]').val(),
                "method": "GET",
                "timeout": 0,
                "headers": {
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                },
            }).then((response) => {
                blockUI(false);
                let totalCommission = 0;
                let percentMultiply = 0;

                if (response.status) {
                    $('#dashboard-total-deposit').html(numberWithCommas(response.data.totalDeposit));
                    $('#dashboard-total-withdraw').html(numberWithCommas(response.data.totalWithdraw));
                    $('#dashboard-total-profit').html(numberWithCommas(response.data.totalProfit));
                    $('#dashboard-total-volume').html(numberWithCommas(response.data.totalVolumeBet));
                    $('#dashboard-total-playProfit').html(numberWithCommas(response.data.totalPlayProfit));
                    $('#dashboard-total-betRefurn').html(numberWithCommas(response.data.totalRefurn));
                    $('#dashboard-total-new-deposit').html(numberWithCommas(response.data.totalNewDeposit));
                    $('#dashboard-total-re-deposit').html(numberWithCommas(response.data.totalReDeposit));
                    $('#dashboard-total-incentive').html(numberWithCommas(response.data.totalIncentive));
                } else {
                    toastr.error(
                        response.msg,
                        "Error!"
                    );
                }
            });
        }

        const getCalculateSystem = () => {
            $.ajax({
                "url": '<%=dataPage.config.API_SERVER%>/dashboard/calculate',
                "method": "GET",
                "timeout": 0,
                "headers": {
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                },
            }).then((response) => {
                if (response.status) {
                    $('#dashboard-total-user').html(numberWithCommas(response.data.totalSystemUser));
                    $('#dashboard-total-user-agency').html(numberWithCommas(response.data.totalSystemUserIsAgency));
                    $('#dashboard-total-register-by-agenccy').html(numberWithCommas(response.data.totalSystemUserRegisterByAgency));
                    //$('#dashboard-total-subsystem').html(numberWithCommas(response.data.totalSystemUser));
                } else {
                    console.log(response);
                    toastr.error(
                        response.msg,
                        "Error!"
                    );
                }
            });
        }

        const getTotalSumBalance = () => {
            $.ajax({
                "url": '<%=dataPage.config.API_SERVER%>/dashboard/sum-balance',
                "method": "GET",
                "timeout": 0,
                "headers": {
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                },
            }).then((response) => {
                if (response.status) {
                    $('#totalSumBalance').html(numberWithCommas(response.totalCoin));
                } else {
                    console.log(response);
                    toastr.error(
                        response.msg,
                        "Error!"
                    );
                }
            });
        }

        // get online 
        // socketSend({ action: { dashboard: { getOnline: true } } });

        const initChartStatis = (data) => {
            createChartFinan({
                deposit: data.deposit,
                withdraw: data.withdraw,
            });
            createChartNewFirstDeposit(data.newFirstDeposit);
            createChartBetRefurn(data.betRefurn);
            createChartIncentive(data.incentive);
            createChartValidBet(data.validBet);
            createChartNewUserReg(data.newUserReg);
        }




        const createChartFinan = (data) => {
            // var a = c3.generate({
            //     bindto: "#data-color",
            //     size: { height: 400 },
            //     data: {
            //         axis: {
            //             x: {
            //                 type: 'category',
            //                 categories: ['cat1', 'cat2', 'ca3', 'ca3', 'ca3', 'ca3']
            //             },
            //         },
            //         columns: [
            //             ["data1", 130, 200, 150, 40, 360, 50],
            //             ["data2", 100, 130, 100, 240, 130, 350],
            //             ["data3", 300, 240, 360, 400, 250, 250],
            //         ],
            //         type: "bar",
            //         colors: { data1: "#009efb", data2: "#7460ee" },
            //         color: function (a, o) {
            //             return o.id && "data3" === o.id ? d3.rgb(a).darker(o.value / 150) : a;
            //         },
            //     },
            //     grid: { y: { show: !0 } },
            // });

            var chart = c3.generate({
                bindto: '#finan-chart-container',
                size: { height: 381 },
                data: {
                    columns: [
                        ['Nạp vào'].concat(Object.values(data.deposit)),
                        ['Rút ra'].concat(Object.values(data.withdraw)),
                    ],
                    type: 'bar',
                    colors: { 'Nạp vào': "#5ac146", 'Rút ra': "#f51616" },
                },
                tooltip: {
                    format: {
                        // title: function (d) {
                        //     return d; // Thay đổi nhãn tiêu đề của tooltip
                        // },
                        value: function (value, ratio, id) {
                            return numberWithCommas(value); // Định dạng giá trị hiển thị
                        }
                    }
                },
                bar: {
                    width: {
                        ratio: 0.5
                    }
                },
                axis: {
                    x: {
                        type: 'category',
                        categories: Object.keys(data.deposit) || Object.keys(data.withdraw), // chứa giá trị giống nhau
                        tick: {
                            // rotate: 0, // Xoay nhãn 75 độ
                            // count: 10, // Hiển thị tối đa 10 nhãn
