    <script>
        const datatable = $('#table-container').DataTable({
            paging: false,
            searching: false,
            info: false,
            order: [[3, 'desc']],
            scrollCollapse: true,
            scrollY: '800px',
            // autoWidth: false,
            columns: [
                { title: "Hành_Động" },
                { title: "Mã_Đại_Lý" },
                { title: "Cấp_Độ" },
                { title: "Các_Cấp_Bên_Trên" },
                { title: "#UID" },
                { title: "Tên_Người_Chơi" },
                { title: "Tên_Đăng_Nhập" },
                { title: "Ngân_Hàng_Người_Dùng" },
                { title: "Số_Điện_Thoại" },
                { title: "Số_Dư_Thành_Viên" },
                { title: "Nạp_Mới" },
                { title: "Số_Lần_Nạp" }, // 100.000
                { title: "Số_Lần_Rút" }, // 100.000
                { title: "Tiền_Nạp" },
                { title: "Tiền_Rút" },
                { title: "Cược_Hợp_Lệ", width: '30px' },
                { title: "Thắng_Thua" },
                { title: "Hoàn_Trả" },
                { title: "Khuyễn_Mãi" },
                { title: "Khuyễn_Mãi_Tặng" },
                { title: "Trạng_Thái" },
                // { title: "ĐK_vòng_cược" },
                { title: "Ngày_Đăng_Ký" },
                // { title: "User_Agent", width: '550px' },
                { title: "IP_Gần_nhất" },
            ],
            fixedColumns: {
                leftColumns: 2,
                // rightColumns: 1
            },
            fixedHeader: {
                header: true,
                footer: true
            },
            responsive: true
        });

        const urlParams = new URLSearchParams(window.location.search);
        $('input[name="from"]').val(urlParams.get('from') ? urlParams.get('from') : moment().format("DD/MM/YYYY"));
