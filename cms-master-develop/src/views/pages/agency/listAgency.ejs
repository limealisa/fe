                                    </tr>
                                </thead>
                                <tbody>
                                    <% if(dataApi.dataExport.length> 0) { %>

                                        <% dataApi.dataExport.forEach((data)=> { %>
                                            <tr>
                                                <td class="text-center">
                                                    <button style="margin-left: 5px;"
                                                        onclick="coppyRefUrl('<%=data.AgencyInfo.code%>')"
                                                        class="btn btn-sm waves-effect waves-light btn-default">
                                                        <span class="btn-icon-left"> <b><i
                                                                    class="fa fa-link color-dark"></i></b>
                                                        </span>
                                                    </button>
                                                    <button style="margin-left: 5px;"
                                                        onclick="showFormUpdateUser('<%=data.id%>', '<%=data.username%>')"
                                                        class="btn btn-sm waves-effect waves-light btn-primary">
                                                        <span class="btn-icon-left"> <b><i
                                                                    class="fa fa-pencil color-dark"></i></b>
                                                        </span>
                                                    </button>
                                                </td>
                                                <td class="text-center" style="font-weight: 600;">
                                                    <%=data.AgencyInfo.code.toUpperCase()%>
                                                </td>
                                                <td class="text-center" style="font-weight: 600;">
                                                    F<%=data.agencyLevel.level%>
                                                </td>
                                                <td>
                                                    <%=data.agencyLevel.upLineAgencyText.slice(0, -1).toUpperCase()%>
                                                </td>
                                                <td>
                                                    #<%=data.id%>
                                                </td>
                                                <td>
                                                    <%=data.name.toUpperCase()%>
                                                </td>
                                                <td>
                                                    <%=data.username.toUpperCase()%>
                                                </td>
                                                <td style="font-family: monospace;white-space: nowrap;">
                                                    <% if(data.BankUser.bankNumber !=null) { %>
                                                        <%=data.BankUser.bankProvide;%>/<%=data.BankUser.bankNumber;%>/
                                                                <%=data.BankUser.bankName;%>
                                                                    <% }else { %>
                                                                        Chưa thêm ngân hàng
                                                                        <% } %>
                                                </td>
                                                <td>
                                                    <%=data.phone%>
                                                </td>
                                                <td>
                                                    <%=dataPage.helpers.numberWithCommas(data.ProfitCalc.totalBalance)%>
                                                </td>
                                                <td>
                                                    <%=dataPage.helpers.numberWithCommas(data.ProfitCalc.totalNewFirstDeposit)%>
                                                </td>
                                                <td>
                                                    <%=dataPage.helpers.numberWithCommas(data.ProfitCalc.totalDepositCount)%>
                                                </td>
                                                <td>
                                                    <%=dataPage.helpers.numberWithCommas(data.ProfitCalc.totalWithdrawCount)%>
                                                </td>
                                                <td>
                                                    <%=dataPage.helpers.numberWithCommas(data.ProfitCalc.totalDeposit)%>
                                                </td>
                                                <td>
                                                    <%=dataPage.helpers.numberWithCommas(data.ProfitCalc.totalWithdraw)%>
                                                </td>
                                                <td>
                                                    <%=dataPage.helpers.numberWithCommas(data.ProfitCalc.totalValidBet)%>
                                                </td>
                                                <td>
                                                    <b style="color:<%=(data.ProfitCalc.totalWinLose > 0) ? "#4210ff" : "brown" %>"><%=dataPage.helpers.numberWithCommas(data.ProfitCalc.totalWinLose)%></b>
                                                </td>
                                                <td>
                                                    <%=dataPage.helpers.numberWithCommas(data.ProfitCalc.totalRefurn)%>
                                                </td>
                                                <td>
                                                    <%=dataPage.helpers.numberWithCommas(data.ProfitCalc.incentive)%>
                                                </td>
                                                <td>
