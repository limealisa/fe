                    //     "root_agency": `<b style="font-weight: 600;" class="text-info">Đại lý này</b>`,
                    //     "root_agency_user": `<b style="font-weight: 600;" class="text-success">Thành viên đại lý này</b>`,
                    //     "children_agency": `<b style="font-weight: 600;" class="text-orange">Đại lý con</b>`,
                    //     "children_agency_user": `<b style="font-weight: 600;" class="text-danger">Thành viên đại lý con</b>`,
                    // }

                    dataUserProfit.forEach((user) => {
                        let listUplineAgency = user.uplineAgency.reverse();
                        listUplineAgency = listUplineAgency.map(agency => agency.username);

                        let 
                        totalDeposit =  
                        totalWithdraw =  
                        totalDepositCount = 
                        totalWithdrawCount =
                        totalValidBet = 
                        totalNetPnl = 
                        totalIncentive =
                        totalIncentiveDonate =
                        totalRefurn = 
                        totalWinLose = 0;

                        // caculator volume
                        user.betRecord.forEach((bet) => {
                            // totalBet += Number(bet.betAmount) * 1000;
                            totalValidBet += Number(bet.validBetAmount) * 1000;
                            totalNetPnl += Number(bet.netPnl) * 1000;
                            // (Number(bet.netPnl) > 0) ? totalWin += Number(bet.netPnl) * 1000: totalLose += Number(bet.netPnl) * 1000;
                        });
                        // caculator user refurn
                        user.betRefurnRecord.forEach((refurn) => {
                            totalRefurn += Number(refurn.amountReturn);
                        });
                        // caculator user incentive
                        user.incentiveRecord.forEach((incentive) => {
                            totalIncentive += Number(incentive.amount);
                        });
                        // caculator user incentive donate
                        user.incentiveDonateRecord.forEach((incentive) => {
                            totalIncentiveDonate += Number(incentive.amount);
                        });
                        // caculator deposit
                        user.depositRecord.forEach((deposit) => {
                            if (deposit.is_first) totalNewFirstDeposit++;
                            totalDepositCount++;
                            totalDeposit += Number(deposit.amount);
                        });
                        // caculator withdraw
                        user.withdrawRecord.forEach((withdraw) => {
                            totalWithdrawCount++;
                            totalWithdraw += Number(withdraw.amount);
                        });

                        // console.log(user.userInfo.username +": " + totalDeposit);

                        totalWinLose = totalDeposit + totalIncentiveDonate + totalRefurn - user.userInfo.coin - totalWithdraw;

                        bodyTable += '<tr>';

                        bodyTable += `<td>
                            ${USER_TAG_TEXT_ENUM[user.tag]}
                        </td>`;
                        bodyTable += `<td>
                            ${(user.agencyLevel) == 0 ? `<b style="font-weight: 600;" class="text-danger">Thành viên</b>` :  `<b style="font-weight: 600;" class="text-info">Đại lý F${user.agencyLevel}</b>`}
                        </td>`;
                        bodyTable += `<td>
                            ${(user.tag == "children_agency_user" || user.tag == "root_agency_user") ? 
                                `${user.parentAgency.username.toLowerCase()}->${user.userInfo.username.toLowerCase()}` 
                              : (user.tag == "root_agency" || user.tag == "children_agency") ? 
                              `${listUplineAgency.join("->")}`
                              : ``
                              }
                        </td>`;
                        bodyTable += `<td>
                            ${user.userInfo.id}
                        </td>`;
                        bodyTable += `<td>
                            ${user.userInfo.name}
                        </td>`;
                        bodyTable += `<td>
                            ${user.userInfo.username}
                        </td>`;
                        bodyTable += `<td>
                            ${(user.parentAgency != null) ? user.parentAgency.agency.code.toLowerCase() : ""}
                        </td>`;
                        bodyTable += `<td>
                            ${user.userInfo.phone}
                        </td>`;
                        bodyTable += `<td>
                            ${numberWithCommas(user.userInfo.coin)}
                        </td>`;
                        bodyTable += `<td>
                            ${numberWithCommas(totalDepositCount)}
                        </td>`;
                        bodyTable += `<td>
                            ${numberWithCommas(totalWithdrawCount)}
                        </td>`;
                        bodyTable += `<td>
                            ${numberWithCommas(totalValidBet)}
                        </td>`;
                        bodyTable += `<td>
                            ${numberWithCommas(totalDeposit)}
                        </td>`;
                        bodyTable += `<td>
                            ${numberWithCommas(totalWithdraw)}
                        </td>`;
                        bodyTable += `<td>
                            ${(totalWinLose) > 0 ? 
                                `<b style="font-weight: 600;" class="text-info">${numberWithCommas(totalWinLose)}</b>` 
                              : `<b style="font-weight: 600;" class="text-danger">${numberWithCommas(totalWinLose)}</b>`}
                        </td>`;
                        bodyTable += `<td>
                            ${numberWithCommas(totalRefurn)}
                        </td>`;
                        bodyTable += `<td>
                            ${numberWithCommas(totalIncentive)}
                        </td>`;
                        bodyTable += `<td>
                            ${numberWithCommas(totalIncentiveDonate)}
                        </td>`;
                        bodyTable += `<td>
                            ${(user.userInfo.status == "active") ? "Hoạt động" : "Bị khóa"}
                        </td>`;
                        bodyTable += `<td>
                            ${(user.withdrawCondi !== null) ? `${numberWithCommas(user.withdrawCondi.minimumNumbOfBet)}/${numberWithCommas(user.withdrawCondi.totalMinimumBetAmount)}`: ""}
                        </td>`; 
                        bodyTable += `<td>
                            ${moment(user.userInfo.createdAt).format("HH:mm - DD/MM/YYYY")}
                        </td>`; 
                        bodyTable += `<td>
                            ${(user.device !== null) ? `${user.device.ip}`: ""}
                        </td>`; 
                        bodyTable += '</tr>';
                    });
                    $('#table-user-profit').html(bodyTable);

                    if (datatableUserProfit) datatableUserProfit.destroy();

