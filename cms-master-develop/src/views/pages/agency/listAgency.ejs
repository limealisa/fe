                "headers": {
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                "data": {
                    bankId: currentBankSelected
                }
            }).then((response) => {
                if (response.status) {
                    toastr.success(
                        "Xóa ngân hàng thành công!",
                        "Success!"
                    );
                } else {
                    toastr.error(
                        response.msg,
                        "Error!"
                    );
                    return;
                }
            }).catch((err) => {
                console.log(err);
                toastr.error(
                    err.message,
                    "Error!"
                );
                return;
            });

        }

