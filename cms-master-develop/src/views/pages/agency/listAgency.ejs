                                                </td> -->
                                                <td>
                                                    <%=dataPage.helpers.moment(data.createdAt).format("DD /MM/YYYY HH:MM:ss")%>
                                                </td>
                                                <td>
                                                    <%=(data.device !=null) ? data.device.ip: "" %>
                                                </td>
