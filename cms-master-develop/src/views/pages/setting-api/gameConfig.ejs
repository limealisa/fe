                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="input-group mb-3">
                                            <span class="input-group-text" id="basic-addon1">Loại trò chơi</span>
                                            <select class="form-control form-select" name="game_type"
                                                data-placeholder="Choose a Category" tabindex="1">
                                                <option value="">Tất Cả</option>
                                                <option value="RNG">RNG - Nổ Hũ</option>
                                                <option value="LIVE">Live - Casino Live</option>
                                                <option value="FISH">Fish - Bắn Cá</option>
                                                <option value="PVP">PVP - Game Thẻ Bài</option>
                                                <option value="SPORTS">SPORTS - Thể Thao</option>
                                                <option value="ESPORTS">ESPORTS - Thể Thao Điện Tử</option>
                                                <option value="COCKFIGHT">COCKFIGHT - Đá Gà</option>
                                                <option value="ELOTTO">ELOTTO - Xổ Số</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <button type="submit" class="btn btn-info align-items-center">
                                        <i class="fa fa-search"></i> Tìm kiếm
                                    </button>
                                    <button type="button" class="btn btn-info align-items-center">
                                        <i class="fa fa-users"></i> Tổng: <o id="total">0</o>
                                    </button>
                                </div>
                            </form>
                        </div>

                        <div class="table-responsive">
                            <table id="table-container" class="table customize-table table-bordered mb-10 v-middle">
                                <thead class="bg-primary text-white">
                                    <tr>
                                        <th>#ID</th>
                                        <th>Trạng thái</th>
                                        <th>Tên nhà cung cấp</th>
                                        <th>Loại trò chơi</th>
                                        <th>Mã trò chơi</th>
                                        <th>Tên trò chơi</th>
                                        <th>Icon</th>
                                        <th>Mô tả</th>
                                        <th>Hỗ trợ chơi thử</th>
                                        <th>Là Game Hot</th>
                                        <th>Số lượng chơi</th>
                                        <th>Ngày Tạo</th>
                                        <th class="text-center">Hành Động</th>
                                    </tr>
                                </thead>
                                <tbody id="product-list">
                                </tbody>
                            </table>
                        </div>

                        <div class="bootstrap-pagination">
                            <nav>
                                <ul class="pagination justify-content-center" id="phantrang"></ul>
                            </nav>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-lg-3">
                <div class="card">
                    <div class="d-flex border-bottom title-part-padding align-items-center">
                        <div>
                            <h4 class="card-title mb-0">
                                Thêm trò chơi mới
                            </h4>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- <h6 class="card-subtitle mb-3">
                            <code>Chỉ thêm khi biết rõ mình đang làm gì!</code>
                        </h6> -->
                        <form class="" id="addProductForm">

                            <div class="form-floating mb-3">
                                <select class="form-select mr-sm-2 lg" id="product_type">
                                    <option value="">Vui lòng chọn nhà cung cấp trò chơi</option>
                                </select>
                                <label>
                                    <i style="color: #5ac146 !important" class="far fa-credit-card"></i> <span
                                        class="border-start border-success ps-3">Chọn nhà cung cấp trò chơi</span>
                                </label>
                            </div>
                            <div class="form-floating mb-3">
                                <select class="form-select mr-sm-2 lg" id="game_type">
                                    <option value="">Loại trò chơi</option>
                                    <option value="RNG">RNG - Nổ Hũ</option>
                                    <option value="LIVE">Live - Casino Live</option>
                                    <option value="FISH">Fish - Bắn Cá</option>
                                    <option value="PVP">PVP - Game Thẻ Bài</option>
                                    <option value="SPORTS">SPORTS - Thể Thao</option>
                                    <option value="ESPORTS">ESPORTS - Thể Thao Điện Tử</option>
                                    <option value="COCKFIGHT">COCKFIGHT - Đá Gà</option>
                                    <option value="ELOTTO">ELOTTO - Xổ Số</option>
                                </select>
                                <label>
                                    <i style="color: #5ac146 !important" class="far fa-credit-card"></i> <span
                                        class="border-start border-success ps-3">Chọn nhà cung cấp trò chơi</span>
                                </label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control border border-success" placeholder="Mã trò chơi"
                                    id="game_code">
                                <label>
                                    <i style="color: #5ac146 !important" class="far fa-credit-card"></i> <span
                                        class="border-start border-success ps-3">Mã trò chơi</span>
                                </label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control border border-success" placeholder="Tên trò chơi"
                                    id="game_name">
                                <label>
                                    <i style="color: #5ac146 !important" class="fas fa-keyboard"></i> <span
                                        class="border-start border-success ps-3">Tên trò chơi</span>
                                </label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control border border-success"
                                    placeholder="Mô tả trò chơi" id="description">
                                <label>
                                    <i style="color: #5ac146 !important" class="fas fa-qrcode"></i> <span
                                        class="border-start border-success ps-3">Mô tả trò chơi</span>
                                </label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="url" class="form-control border border-success"
                                    placeholder="Hình ảnh Icon trò chơi" id="game_icon">
                                <label>
                                    <i style="color: #5ac146 !important" class="fas fa-qrcode"></i> <span
                                        class="border-start border-success ps-3">Hình ảnh Icon trò chơi</span>
                                </label>
                            </div>
                            <div class="d-md-flex align-items-center">
                                <div class="mt-3 mt-md-0 ms-auto">
                                    <button type="submit" class="btn btn-success">
                                        <div class="d-flex align-items-center">
                                            Thêm trò chơi
                                        </div>
                                    </button>
                                </div>
                            </div>
                        </form>

                    </div>
                </div>
            </div>


        </div>
        <!-- row -->
        <!-- -------------------------------------------------------------- -->
        <!-- End PAge Content -->
        <!-- -------------------------------------------------------------- -->
    </div>
    <script>
        $('#table-container').DataTable({
            paging: false,
            searching: false,
            info: false,
            order: [[0, 'desc']],           
        });

        let FILTER = {
            page: 1,
            limit: 10,
            game_code: '',
            game_name: '',
            product_type: '',
            game_type: ''
        };
        $(document).ready(() => {
            getListProductConfig();
            getListGameConfig();

            $("input[name='game_code']").on('keyup', (e) => {
                changeFilter('game_code', e.target.value);
            })
            $("input[name='game_name']").on('keyup', (e) => {
                changeFilter('game_name', e.target.value);
            })
            $("select[name='product_type']").on('change', (e) => {
                changeFilter('product_type', e.target.value);
            })
            $("select[name='game_type']").on('change', (e) => {
                changeFilter('game_type', e.target.value);
            });

        });

        const getListProductConfig = async () => {
            let config = {
                method: 'get',
                maxBodyLength: Infinity,
                url: '<%=dataPage.config.API_SERVER%>/setting-api/product-config',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer <%=dataPage.session.accessToken%>',
                }
            };

            $.ajax(config).done(function (response) {
                if (response.status) {
                    const data = response.data;
                    let html = '<option value="">Chọn nhà cung cấp trò chơi</option>';
                    data.forEach((item) => {
                        if (!item.is_mainternance) html += `<option value="${item.product_type}">${item.product_code} - ${item.product_api} ${(item.is_mainternance) ? "- Đang bảo trì" : ""}</option>`;
                    });
                    $('#product_type').html(html);
                    let htmlFilter = '<option value="">Tất cả</option>';
                    data.forEach((item) => {
                        htmlFilter += `<option value="${item.product_type}">${item.product_code} - ${item.product_api}</option>`;
                    });
                    $('select[name="product_type"]').html(htmlFilter);
                }
            });
        }

        const getListGameConfig = async () => {
            const filter = $.param(FILTER);
            const api = "<%=dataPage.config.API_SERVER%>/setting-api/game-config?" + filter;
            $.ajax({
                method: 'get',
                maxBodyLength: Infinity,
                url: api,
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer <%=dataPage.session.accessToken%>',
                }
            }).done(function (response) {
                if (response.status) {
                    const data = response.data.dataExport;
                    const total = response.data.total;
                    // const total = 1000;
                    const kmess = response.data.kmess;
                    const page = response.data.page;

                    $("#total").html(numberWithCommas(total));

                    $("#product-list").html("");
                    let body = "";
                    data.forEach((item) => {
                        body += `
                        <tr>
                            <td>
                                ${item.id}
                            </td>
                            <td>
                                ${(item.is_mainternance) ? "Đang bảo trì" : "Hoạt động"}
                            </td>
                            <td>
                                ${item.product_code} - ${item.product_type}
                            </td>
                            <td>
                                ${item.game_type}
                            </td>
                            <td>
                                ${item.game_code}
                            </td>
                            <td>
                                ${item.game_name}
                            </td>
                            <td>
                                <img style="margin-top: -6px; width: 35px;" src="${item.game_icon}"
                                    class="img-fluid user-img">
                            </td>
                            <td>
                                ${(item.description == null) ? "" : item.description}
                            </td>
                            <td>
                                ${(item.game_trial_support) ? "Có" : "Không"}
                            </td>
                            <td>
                                ${(item.is_hot) ? "Có" : "Không"}
                            </td>
                            <td>
                                ${numberWithCommas(item.play_count)}
                            </td>
                            <td>
                                ${moment(item.createdAt).format("HH:mm:ss DD/MM/YYYY")}
                            </td>
                            <td class="text-center">
                                <button style="margin-left: 10px;"
                                    onclick="deleteDailyConfirm('${item.id}')" type="button"
                                    class="btn btn-sm btn-sm waves-effect waves-light btn-danger"><span
                                        class="btn-icon-left">
                                        <b><i class="fa fa-trash color-dark"></i></b>
                                    </span>
                                </button>
                            </td>
                        </tr>
                        `;
                    });
                    $('#product-list').html(body);

                    const phantrang = Pagination(page, total, kmess);

                    const urlSearchParams = new URLSearchParams(window.location.search);
                    urlSearchParams.delete("page");
                    urlSearchParams.delete("limit");

                    let phantrangBody = '';
                    phantrang.forEach((page) => {
                        $("#phantrang").html(phantrangBody);
                        let active = (response.data.page == page) ? "active" : "";
                        const urlToPage = (page !== "...") ? `javascript:goToPage(${page})` : `javascript:void(0)`;
                        phantrangBody += `
                            <li class="page-item ${active}">
                                <a class="page-link" href="${urlToPage}"><b>${page}</b></a>
                            </li>
                        `;
                        $("#phantrang").html(phantrangBody);
                    });
                    
                }
            });
        }

        const changeFilter = (key, value) => FILTER[key] = value;

        const goToPage = (page) => {
            changeFilter('page', page);
            getListGameConfig();
        }

        $('#addProductForm').on('submit', (e) => {
            e.preventDefault();

            const product_type = $("select[id=product_type]").val();
            const game_type = $("select[id=game_type]").val();
            const game_code = $("input[id=game_code]").val();
            const game_name = $("input[id=game_name]").val();
            const description = $("input[id=description]").val();
            const game_icon = $("input[id=game_icon]").val();

            // console.log(product_type,
            // game_type,
            // game_code,
            // game_name,
            // description,
            // game_icon);

            if (!product_type ||
                !game_type ||
                !game_code ||
                !game_name ||
                !game_icon
            ) {
                toastr.error(
                    "Vui lòng điền đầy đủ thông tin.",
                    "Error!"
                );
                return;
            }

            cuteAlert({
                type: "question",
                title: "Hành Động",
                message: "Bạn có chắc chắn các thông tin vừa nhập?",
                confirmText: "Đồng ý",
                cancelText: "Hủy"
            }).then((e) => {
                if (e == 'confirm') {
                    $.ajax({
                        "url": `<%=dataPage.config.API_SERVER%>/setting-api/game-config`,
                        "method": "POST",
                        "timeout": 0,
                        "headers": {
                            "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                            "Content-Type": "application/json"
                        },
                        "data": JSON.stringify({
                            "product_type": product_type,
                            "game_type": game_type,
                            "game_code": game_code,
                            "game_name": game_name,
                            "description": description,
                            "game_icon": game_icon
                        })
                    }).then((response) => {
                        if (response.status) {
                            toastr.success(
                                "Thành công.",
                                "Success!"
                            );
                            getListGameConfig();
                            // setTimeout(() => {
                            //     window.location = "";
                            // }, 1000);
                        } else {
                            toastr.error(
                                response.msg,
                                "Error!"
                            );
                        }
                    }).catch((err) => {
                        console.log(err);
                        toastr.error(
                            err.responseJSON.msg,
                            "Error!"
                        );
                    });
                }
            });
        });

        $('#gameConfigFilter').on('submit', (e) => {
            e.preventDefault();
            changeFilter('page', 1);
            getListGameConfig();
        }); 

        const deleteDailyConfirm = (id) => {
            cuteAlert({
                type: "question",
                title: "Hành Động",
                message: "Bạn có muốn xóa nó không?",
                confirmText: "Đồng ý",
                cancelText: "Hủy"
            }).then((e) => {
                if (e == 'confirm') {
                    $.ajax({
                        "url": '<%=dataPage.config.API_SERVER%>/setting-api/game-config/' + id + '/delete',
                        "method": "POST",
                        "timeout": 0,
                        "headers": {
                            "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                        },
                        "data": {}
                    }).then((response) => {
                        if (response.status) {
                            toastr.success(
                                "Thành công.",
                                "Success!"
                            );
                            getListGameConfig();
                        } else {
                            toastr.error(
                                response.msg,
                                "Error!"
                            );
                        }
                    }).catch((err) => {
                        console.log(err);
                        toastr.error(
                            err.responseJSON.msg,
                            "Error!"
                        );
                    });
                }
            });
        }
    </script>
    <%- include('../../includes/footer') %>