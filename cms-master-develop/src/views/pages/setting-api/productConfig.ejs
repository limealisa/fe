<%- include('../../includes/header') %>
<script>
    $(document).ready(() => {
        setTimeout(() => {
            // colapse sidebar
            $("#main-wrapper").attr("data-sidebartype", "mini-sidebar");
            $("#main-wrapper").addClass("mini-sidebar");
        }, 100);
    });
</script>

    <div class="container-fluid">
        <!-- -------------------------------------------------------------- -->
        <!-- Start Page Content -->
        <!-- -------------------------------------------------------------- -->
        <div class="row">
            <div class="col-lg-9">
                <div class="card">
                    <div class="card-header border-bottom title-part-padding d-flex align-items-center">
                        <h4 class="card-title"><%=dataPage.title%></h4>
                        <div class="card-actions ms-auto d-flex button-group">
                          <a class="mb-0 btn-minimize link d-flex align-items-center" data-action="expand">
                            <i class="ri-fullscreen-line fs-6"></i>
                          </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- <h6 class="card-subtitle mb-3">
                            <code>Chỉ chỉnh sửa khi biết rõ mình đang làm gì!</code>
                        </h6> -->
                        <div class="table-responsive">
                            <table id="table-container" class="table customize-table table-bordered mb-10 v-middle">
                                <thead class="bg-primary text-white">
                                    <tr>
                                        <th>#ID</th>
                                        <th>Trạng thái</th>
                                        <th>Cấu hình API</th>
                                        <th>Tên nhà cung cấp</th>
                                        <th>Mã định danh</th>
                                        <th>Mã số phân biệt</th>
                                        <th>Mô tả</th>
                                        <th>Logo</th>
                                        <th>Thumbnail</th>
                                        <th>Icon</th>
                                        <th>Ngày Tạo</th>
                                        <th class="text-center">Hành Động</th>
                                    </tr>
                                </thead>
                                <tbody id="product-list"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3">
                <div class="card">
                    <div class="d-flex border-bottom title-part-padding align-items-center">
                        <div>
                            <h4 class="card-title mb-0">
                                Thêm nhà cung cấp trò chơi
                            </h4>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- <h6 class="card-subtitle mb-3">
                            <code>Chỉ thêm khi biết rõ mình đang làm gì!</code>
                        </h6> -->
                        <form class="" id="addProductForm">

                            <div class="form-floating mb-3">
                                <select class="form-select mr-sm-2 lg" id="product_api">
                                    <option value="">Vui lòng chọn cấu hình API</option>
                                </select>
                                <label>
                                    <i style="color: #5ac146 !important" class="far fa-credit-card"></i> <span
                                        class="border-start border-success ps-3">Chọn cấu hình API</span>
                                </label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control border border-success"
                                    placeholder="Tên nhà cung cấp" id="product_name">
                                <label>
                                    <i style="color: #5ac146 !important" class="far fa-credit-card"></i> <span
                                        class="border-start border-success ps-3">Tên nhà cung cấp</span>
                                </label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control border border-success"
                                    placeholder="Mã định danh nhà cung cấp" id="product_code">
                                <label>
                                    <i style="color: #5ac146 !important" class="fas fa-keyboard"></i> <span
                                        class="border-start border-success ps-3">Mã định danh nhà cung cấp</span>
                                </label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control border border-success"
                                    placeholder="Mã số phân biệt nhà cung cấp" id="product_type">
                                <label>
                                    <i style="color: #5ac146 !important" class="fas fa-user-circle"></i> <span
                                        class="border-start border-success ps-3">Mã số phân biệt nhà cung cấp</span>
                                </label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control border border-success"
                                    placeholder="Mô tả về nhà cung cấp này" id="description">
                                <label>
                                    <i style="color: #5ac146 !important" class="fas fa-qrcode"></i> <span
                                        class="border-start border-success ps-3">Mô tả về nhà cung cấp này</span>
                                </label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="url" class="form-control border border-success" placeholder="Hình ảnh logo"
                                    id="logo">
                                <label>
                                    <i style="color: #5ac146 !important" class="fas fa-qrcode"></i> <span
                                        class="border-start border-success ps-3">Hình ảnh logo</span>
                                </label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="url" class="form-control border border-success"
                                    placeholder="Hình ảnh thumbnail" id="thumbnail">
                                <label>
                                    <i style="color: #5ac146 !important" class="fas fa-qrcode"></i> <span
                                        class="border-start border-success ps-3">Hình ảnh thumbnail</span>
                                </label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="url" class="form-control border border-success" placeholder="Hình ảnh icon"
                                    id="icon">
                                <label>
                                    <i style="color: #5ac146 !important" class="fas fa-qrcode"></i> <span
                                        class="border-start border-success ps-3">Hình ảnh icon</span>
                                </label>
                            </div>
                            <div class="d-md-flex align-items-center">
                                <div class="mt-3 mt-md-0 ms-auto">
                                    <button type="submit" class="btn btn-success">
                                        <div class="d-flex align-items-center">
                                            Thêm nhà cung cấp
                                        </div>
                                    </button>
                                </div>
                            </div>
                        </form>

                    </div>
                </div>
            </div>


        </div>
        <!-- row -->
        <!-- -------------------------------------------------------------- -->
        <!-- End PAge Content -->
        <!-- -------------------------------------------------------------- -->
    </div>
    <script>
        $('#table-container').DataTable({
            paging: false,
            searching: false,
            info: false,
            order: [[0, 'desc']],
        });
        $(document).ready(() => {
            getListApiConfig();
            getListProductConfig();
        });

        const getListApiConfig = async () => {
            let config = {
                method: 'get',
                maxBodyLength: Infinity,
                url: '<%=dataPage.config.API_SERVER%>/setting-api/api-config',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer <%=dataPage.session.accessToken%>',
                }
            };

            $.ajax(config).done(function (response) {
                if (response.status) {
                    const data = response.data;
                    let html = '<option value="">Vui lòng chọn cấu hình API</option>';
                    data.forEach((item) => {
                        if (!item.is_mainternance) html += `<option value="${item.api_name}">${item.api_name} - ${item.api_product}</option>`;
                    });
                    $('#product_api').html(html);
                }
            });
        }

        const getListProductConfig = async () => {
            let config = {
                method: 'get',
                maxBodyLength: Infinity,
                url: '<%=dataPage.config.API_SERVER%>/setting-api/product-config',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer <%=dataPage.session.accessToken%>',
                }
            };

            $.ajax(config).done(function (response) {
                if (response.status) {
                    const data = response.data;
                    $("#product-list").html("");
                    let body = "";
                    data.forEach((item) => {
                        body += `
                        <tr>
                            <td>
                                ${item.id}
                            </td>
                            <td>
                                ${(item.is_mainternance) ? "Đang bảo trì": "Hoạt động"}
                            </td>
                            <td>
                                ${item.product_api}
                            </td>
                            <td>
                                ${item.product_name}
                            </td>
                            <td>
                                ${item.product_code}
                            </td>
                            <td>
                                ${item.product_type}
                            </td>
                            <td>
                                ${(item.description == null) ? "": item.description}
                            </td>
                            <td>
                                <img style="margin-top: -6px; width: 35px;" src="${item.logo}"
                                    class="img-fluid user-img">
                            </td>
                            <td>
                                <img style="margin-top: -6px; width: 35px;" src="${item.thumbnail}"
                                    class="img-fluid user-img">
                            </td>
                            <td>
                                <img style="margin-top: -6px; width: 35px;" src="${item.icon}"
                                    class="img-fluid user-img">
                            </td>
                            <td>
                                ${moment(item.createdAt).format("HH:mm:ss DD/MM/YYYY")}
                            </td>
                            <td class="text-center">
                                <button style="margin-left: 10px;"
                                    onclick="deleteDailyConfirm('${item.id}')" type="button"
                                    class="btn btn-sm waves-effect waves-light btn-danger"><span
                                        class="btn-icon-left">
                                        <b><i class="fa fa-trash color-dark"></i></b>
                                    </span>
                                </button>
                            </td>
                        </tr>
                        `;
                    });
                    $('#product-list').html(body);
                }
            });
        }

        $('#addProductForm').on('submit', (e) => {
            e.preventDefault();

            const product_api = $("select[id=product_api]").val();
            const product_name = $("input[id=product_name]").val();
            const product_code = $("input[id=product_code]").val();
            const product_type = $("input[id=product_type]").val();
            const description = $("input[id=description]").val();
            const logo = $("input[id=logo]").val();
            const thumbnail = $("input[id=thumbnail]").val();
            const icon = $("input[id=icon]").val();

            // console.log(product_api,
            //     product_name,
            //     product_code,
            //     product_type,
            //     logo,
            //     thumbnail,
            //     icon);

            if (!product_api ||
                !product_name ||
                !product_code ||
                !product_type ||
                !logo ||
                !thumbnail ||
                !icon
            ) {
                toastr.error(
                    "Vui lòng điền đầy đủ thông tin.",
                    "Error!"
                );
                return;
            }

            cuteAlert({
                type: "question",
                title: "Hành Động",
                message: "Bạn có chắc chắn các thông tin vừa nhập?",
                confirmText: "Đồng ý",
                cancelText: "Hủy"
            }).then((e) => {
                if (e == 'confirm') {
                    $.ajax({
                        "url": `<%=dataPage.config.API_SERVER%>/setting-api/product-config`,
                        "method": "POST",
                        "timeout": 0,
                        "headers": {
                            "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                            "Content-Type": "application/json"
                        },
                        "data": JSON.stringify({
                            "product_api": product_api,
                            "product_name": product_name,
                            "product_code": product_code,
                            "product_type": product_type,
                            "description": description,
                            "logo": logo,
                            "thumbnail": thumbnail,
                            "icon": icon
                        })
                    }).then((response) => {
                        if (response.status) {
                            toastr.success(
                                "Thành công.",
                                "Success!"
                            );
                            // setTimeout(() => {
                            //     window.location = "";
                            // }, 1000);
                        } else {
                            toastr.error(
                                response.msg,
                                "Error!"
                            );
                        }
                    }).catch((err) => {
                        console.log(err);
                        toastr.error(
                            err.responseJSON.msg,
                            "Error!"
                        );
                    });
                }
            });

        });

        const deleteDailyConfirm = (id) => {
            cuteAlert({
                type: "question",
                title: "Hành Động",
                message: "Bạn có muốn xóa nó không?",
                confirmText: "Đồng ý",
                cancelText: "Hủy"
            }).then((e) => {
                if (e == 'confirm') {
                    $.ajax({
                        "url": '<%=dataPage.config.API_SERVER%>/setting-api/product-config/' + id + '/delete',
                        "method": "POST",
                        "timeout": 0,
                        "headers": {
                            "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                        },
                        "data": {}
                    }).then((response) => {
                        if (response.status) {
                            toastr.success(
                                "Thành công.",
                                "Success!"
                            );
                            setTimeout(() => {
                                window.location = "";
                            }, 700);
                        } else {
                            toastr.error(
                                response.msg,
                                "Error!"
                            );
                        }
                    }).catch((err) => {
                        console.log(err);
                        toastr.error(
                            err.responseJSON.msg,
                            "Error!"
                        );
                    });

                }
            });
        }
    </script>
    <%- include('../../includes/footer') %>