<%- include('../../includes/header') %>

    <div id="elementModal"> </div>
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="d-flex border-bottom title-part-padding align-items-center">
                        <div>
                            <h4 class="card-title mb-0">
                                <%=dataPage.title%>
                            </h4>
                        </div>
                        <div class="ms-auto">
                            <div class="dl">
                                <button type="button" class="btn btn-info align-items-center"
                                    onclick="showModalCreateCmsAccount()">
                                    <i class="fa fa-plus"></i> Thêm mới
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="table-container" class="table customize-table table-bordered mb-10 v-middle">
                                <thead class="bg-primary text-white">
                                    <tr>
                                        <th>#UID</th>
                                        <th>Tên Quản Trị Viên</th>
                                        <th>Tên Đăng Nhập</th>
                                        <th>Vai Trò</th>
                                        <th>Email</th>
                                        <th>Số Điện Thoại</th>
                                        <th>Trạng thái</th>
                                        <th>Thời gian tạo</th>
                                        <th class="text-center">Hành Động</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if(dataApi.dataExport.length> 0) { %>

                                        <% dataApi.dataExport.forEach((data)=> { %>
                                            <tr>
                                                <td>
                                                    #<%=data.id%>
                                                </td>
                                                <td>
                                                    <%=data.name.toUpperCase()%>
                                                </td>
                                                <td>
                                                    <%=data.username.toUpperCase()%>
                                                </td>
                                                <td>
                                                    <%=data.position%>
                                                </td>
                                                <td>
                                                    <%=data.phone%>
                                                </td>
                                                <td>
                                                    <%=data.email%>
                                                </td>
                                                <td>
                                                    <%=(data.status=="active" ) ? 'Hoạt động' : 'Bị khóa' %>
                                                </td>
                                                <td>
                                                    <%=dataPage.helpers.moment(data.createdAt).format("H:mm - DD/MM/YYYY")%>
                                                </td>
                                                <td class="text-center">
                                                    <button style="margin-left: 10px;"
                                                        onclick="showAccountInfo('<%=data.id%>', '<%=data.username%>')"
                                                        class="btn btn-sm waves-effect waves-light btn-primary">
                                                        <span class="btn-icon-left"> <b><i
                                                                    class="fa fa-pencil color-dark"></i></b>
                                                        </span>
                                                    </button>
                                                    <button style="margin-left: 10px;"
                                                        onclick="deleteAccount('<%=data.id%>')"
                                                        class="btn btn-sm waves-effect waves-light btn-danger">
                                                        <span class="btn-icon-left"> <b><i
                                                                    class="fa fa-trash color-dark"></i></b>
                                                        </span>
                                                    </button>
                                                </td>
                                            </tr>
                                            <% }); %>
                                                <% } %>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>

        </div>

    </div>


    <script>
        let SYSTEM_PERMISSION = [];

        $(document).ready(() => {
            $('#table-container').DataTable({
                paging: false,
                searching: false,
                info: false,
                order: [[0, 'desc']],
            });
            getSysPerms();
        });

        const getSysPerms = () => {
            $.ajax({
                url: '<%=dataPage.config.API_SERVER%>/cms-account/sys-perms',
                method: 'GET',
                "timeout": 0,
                "headers": {
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                },
                success: (response) => {
                    SYSTEM_PERMISSION = response.data;
                },
                error: (error) => {
                    console.log(error);
                }
            });
        }

        const showModalCreateCmsAccount = () => {
            $('#elementModal').html(`
                    <div class="modal fade" id="create-cms-account-modal" tabindex="-1" aria-labelledby="exampleModalLabel1">
                        <div class="modal-dialog modal-md" role="document">
                            <div class="modal-content">
                                <div class="modal-header d-flex align-items-center">
                                    <h4 class="modal-title" id="exampleModalLabel1">
                                        Tạo tài khoản quản trị
                                    </h4>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <form>
                                        <div class="mb-3">
                                            <label for="recipient-name" class="control-label">Họ và tên:</label>
                                            <input type="text" class="form-control" id="create-cms-account-name"/>
                                        </div>
                                        <div class="mb-3">
                                            <label for="recipient-name" class="control-label">Tên tài khoản:</label>
                                            <input type="text" class="form-control" id="create-cms-account-username"/>
                                        </div>
                                        <div class="mb-3">
                                            <label for="recipient-name" class="control-label">Người dùng có vai trò gì:</label>
                                            <input type="text" class="form-control" id="create-cms-account-position" placeholder="Quản lý nạp rút..."/>
                                        </div>
                                        <div class="mb-3">
                                            <label for="recipient-name" class="control-label">Mật khẩu tài khoản:</label>
                                            <input type="password" class="form-control" id="create-cms-account-password"/>
                                        </div>
                                        <div class="mb-3">
                                            <label for="recipient-name" class="control-label">Email:</label>
                                            <input type="text" class="form-control" id="create-cms-account-email"/>
                                        </div>
                                        <div class="mb-3">
                                            <label for="recipient-name" class="control-label">Số điện thoại:</label>
                                            <input type="text" class="form-control" id="create-cms-account-phone"/>
                                        </div>
                                    </form>
                                </div>
                                <div class="modal-footer">
                                    <a class="btn btn-success" href="javascript:CreateCmsAccount()">
                                        Xác nhận
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- /.modal -->
            `);

            $('#create-cms-account-modal').modal('toggle');
        }

        const CreateCmsAccount = () => {
            const name = $('#create-cms-account-name').val();
            const username = $('#create-cms-account-username').val();
            const position = $('#create-cms-account-position').val();
            const password = $('#create-cms-account-password').val();
            const email = $('#create-cms-account-email').val();
            const phone = $('#create-cms-account-phone').val();

            if (!name || !username || !position || !password || !email || !phone) {
                toastr.error(
                    "Vui lòng điền đầy đủ thông tin!",
                    "Error!"
                );
                return;
            }

            cuteAlert({
                type: "question",
                title: "Hành Động",
                message: "Bạn đã kiểm tra kĩ thông tin rồi chứ?",
                confirmText: "Tạo",
                cancelText: "Hủy"
            }).then((e) => {
                if (e == 'confirm') {
                    $.ajax({
                        "url": '<%=dataPage.config.API_SERVER%>/cms-account',
                        "method": "POST",
                        "timeout": 0,
                        "headers": {
                            "Content-Type": "application/json",
                            "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                        },
                        "data": JSON.stringify({
                            name,
                            username,
                            position,
                            password,
                            email,
                            phone,
                        })
                    }).then((response) => {
                        if (response.status) {
                            $('#create-cms-account-modal').modal('toggle');
                            toastr.success(
                                "Tạo tài khoản thành công.",
                                "Success!"
                            );
                            setTimeout(() => {
                                window.location = "";
                            }, 700);
                        } else {
                            toastr.error(
                                response.msg,
                                "Error!"
                            );
                        }
                    }).catch((err) => {
                        console.log(err);
                        toastr.error(
                            err.responseJSON.msg,
                            "Error!"
                        );
                    });
                }
            });
        }

        const deleteAccount = (id) => {
            cuteAlert({
                type: "question",
                title: "Hành Động",
                message: "Bạn có muốn xóa tài khoản này không?",
                confirmText: "Đồng ý",
                cancelText: "Hủy"
            }).then((e) => {
                if (e == 'confirm') {
                    $.ajax({
                        "url": '<%=dataPage.config.API_SERVER%>/cms-account/delete/' + id,
                        "method": "GET",
                        "timeout": 0,
                        "headers": {
                            "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                        },
                    }).then((response) => {
                        if (response.status) {
                            toastr.success(
                                "Thành công.",
                                "Success!"
                            );
                            setTimeout(() => {
                                window.location = "";
                            }, 700);
                        } else {
                            toastr.error(
                                response.msg,
                                "Error!"
                            );
                        }
                    }).catch((err) => {
                        console.log(err);
                        toastr.error(
                            err.responseJSON.msg,
                            "Error!"
                        );
                    });
                }
            });
        }

        const updatePermAccount = (id, permission, name) => {
            const permAllow = $("#permision-item-" + permission).prop("checked");
            $.ajax({
                "url": '<%=dataPage.config.API_SERVER%>/cms-account/update-permission/' + id,
                "method": "POST",
                "timeout": 0,
                "headers": {
                    "Content-Type": "application/json",
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                },
                "data": JSON.stringify({
                    permission,
                    allow: permAllow
                })
            }).then((response) => {
                if (response.status) {
                    toastr.info(
                        `${name}`,
                        "Đã cập nhật quyền"
                    );
                } else {
                    toastr.error(
                        response.msg,
                        "Error!"
                    );
                }
            }).catch((err) => {
                console.log(err);
                toastr.error(
                    err.responseJSON.msg,
                    "Error!"
                );
            });

        }

        const showAccountInfo = (id, name) => {
            const findPersInUserPers = (userPers, perms) => {
                let isFinded = false;
                for (const userP of userPers) { if (userP.position == perms) { if (userP.allow == true) isFinded = true; break; } }
                return isFinded;
            }

            blockUI(true);
            $.ajax({
                "url": '<%=dataPage.config.API_SERVER%>/cms-account/account-info/' + id,
                "method": "GET",
                "timeout": 0,
                "headers": {
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                },
            }).then((response) => {
                if (response.status) {
                    $(".offCanvasElement").html(`
                            <div class="offcanvas offcanvas-bottom" data-bs-scroll="true" tabindex="-1" id="offcanvas-container"
                            aria-labelledby="offcanvas-below-label" style="min-height: 100%;">
                            <div class="offcanvas-header">
                                <h5 class="offcanvas-title">Chi tiết quản trị viên - ${response.data.username} </h5>
                                <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                            </div>
                            <div class="offcanvas-body">
                                <div class="row" id="offcanvas-body" style="">
                                    
                                    <div class="col-md-2">
                                        <div class="card card-in-card">
                                            <div class="d-flex border-bottom title-part-padding align-items-center">
                                                <div>
                                                    <h4 class="card-title mb-0">
                                                        Thông tin tài khoản
                                                    </h4>
                                                </div>
                                            </div>
                                            <div class="card-body">
                                                <div class="row">
                                                    <div class="mb-3">
                                                        <label for="recipient-name" class="control-label">Họ và tên:</label>
                                                        <input type="text" class="form-control" id="update-name" value="${response.data.name}"/>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="recipient-name" class="control-label">Tên đăng nhập:</label>
                                                        <input type="text" class="form-control" id="update-username" value="${response.data.username}"/>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="recipient-name" class="control-label">Địa chỉ Email:</label>
                                                        <input type="email" class="form-control" id="update-email" value="${response.data.email}"/>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="recipient-name" class="control-label">Số điện thoại:</label>
                                                        <input type="text" class="form-control" id="update-phone" value="${response.data.phone}"/>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="recipient-name" class="control-label">Trạng thái tài khoản:</label>
                                                        <select class="form-control form-select" id="update-status"></select>
                                                    </div>
                                                    <a class="btn btn-success" href="javascript:updateUser('${id}')">
                                                        Cập nhật
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                        <a class="btn btn-success" href="javascript:showFormChangePass('${id}', '${name}')">
                                            Đổi mật khẩu
                                        </a>
                                    </div>
                                    
                                    <div class="col-md-10">
                                        <div class="card card-in-card">
                                            <div class="d-flex border-bottom title-part-padding align-items-center">
                                                <h4 class="card-title mb-0">
                                                    Quyền hạn tài khoản
                                                </h4>
                                            </div>
                                            <div class="card-body">
                                                <div class="row" id="account-perms-container">
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    `);

                    if (response.data.status == "active") {
                        $('#update-status').append(`<option value="active">Hoạt động</option>`);
                        $('#update-status').append(`<option value="blocked">Bị khóa</option>`);
                    } else {
                        $('#update-status').append(`<option value="blocked">Bị khóa</option>`);
                        $('#update-status').append(`<option value="active">Hoạt động</option>`);
                    }

                    offCanvas($("#offcanvas-container"));

                    const userPers = response.data.account_permission;
                    $("#account-perms-container").html("");
                    SYSTEM_PERMISSION.forEach((sysPers) => {
                        $("#account-perms-container").append(`
                            <div class="col-md-3" style="margin-bottom:20px;">
                                <div class="form-check form-check-inline">
                                    <input 
                                        style="cursor: pointer;" 
                                        class="form-check-input secondary check-outline outline-secondary" 
                                        type="checkbox" 
                                        id="permision-item-${sysPers.position}"
                                        onclick="updatePermAccount('${id}', '${sysPers.position}', '${sysPers.name}')"
                                        ${(findPersInUserPers(userPers, sysPers.position)) ? "checked" : ""} />
                                    <label class="form-check-label" for="permision-item-${sysPers.position}">${sysPers.name}</label>
                                </div>
                            </div>
                        `);
                    });

                } else {
                    toastr.error(
                        response.msg,
                        "Error!"
                    );
                }
                blockUI(false);
            }).catch((err) => {
                console.log(err);
                toastr.error(
                    err.msg,
                    "Error!"
                );
                blockUI(false);
            });

        }

        const updateUser = (id) => {
            const name = $('#update-name').val();
            const username = $('#update-username').val();
            const email = $('#update-email').val();
            const phone = $('#update-phone').val();
            const status = $('#update-status').val();

            if (!name || !username || !email || !phone) {
                toastr.error(
                    "Vui lòng điền đầy đủ thông tin!",
                    "Error!"
                );
                return;
            }

            $.ajax({
                "url": "<%=dataPage.config.API_SERVER%>/cms-account/update/" + id,
                "method": "POST",
                "timeout": 0,
                "headers": {
                    "Content-Type": "application/json",
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                },
                "data": JSON.stringify({
                    name,
                    username,
                    email,
                    phone,
                    status
                }),
            }).done(function (response) {
                if (response.status) {
                    toastr.success(
                        response.msg,
                        "Success!"
                    );
                } else {
                    toastr.error(
                        response.msg,
                        "Error!"
                    );
                }
            });
        }

        const showFormChangePass = (id, name) => {
            $("div.modal-backdrop").remove();

            $('#elementModal').html(`
                <!-- Modal Change Password-->
                <!-- Code Modal -->
                <div id="user-change-passworrd-modal" class="modal fade" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-sm">
                        <div class="modal-content">
                            <div class="modal-header border-bottom">
                                <h5 class="modal-title" id="exampleModalLabel">
                                    <i class="fas fa-key"></i> <b>Đổi Mật Khẩu - ${name}</b>
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body p-4">
                                <div class="text-center">
                                        <div class="form-floating mb-3">
                                            <input type="password" class="form-control border border-primary"
                                                placeholder="Nhập mật khẩu mới..." name="newPassword">
                                            <label><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    class="feather feather-lock feather-sm text-primary fill-white me-2">
                                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                                </svg><span class="border-start border-primary ps-3">Mật khẩu mới</span></label>
                                        </div>
                                        <div class="form-floating mb-3">
                                            <input type="password" class="form-control border border-primary"
                                                placeholder="Nhập lại mật khẩu mới..." name="confirmPassword">
                                            <label><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    class="feather feather-lock feather-sm text-primary fill-white me-2">
                                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                                </svg><span class="border-start border-primary ps-3">Xác nhận lại mật khẩu
                                                    mới</span></label>
                                        </div>

                                        <div class="form-floating mb-3" id="notifyElement-changepassword"></div>

                                        <div class="d-md-flex align-items-center">
                                            <div class="mt-3 mt-md-0 ms-auto">
                                                <button onclick="changePassword('${id}')" type="submit" class="btn btn-primary font-weight-medium rounded-pill px-4">
                                                    <div class="d-flex align-items-center">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                                            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                            stroke-linecap="round" stroke-linejoin="round"
                                                            class="feather feather-send feather-sm fill-white me-2">
                                                            <line x1="22" y1="2" x2="11" y2="13"></line>
                                                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                                        </svg>
                                                        Đổi mật khẩu
                                                    </div>
                                                </button>
                                            </div>
                                        </div>
                                </div>
                            </div>
                        </div>
                        <!-- /.modal-content -->
                    </div>
                    <!-- /.modal-dialog -->
                </div>
                <!-- /.modal -->
                <!-- End Modal Change Password-->
            `);

            $('#user-change-passworrd-modal').modal('toggle');
        }

        const changePassword = (id) => {
            const notifyElement = $("#notifyElement-changepassword");
            const dailyPassword = $("input[name=newPassword]").val();
            const dailyPasswordConfirm = $("input[name=confirmPassword]").val();

            if (!dailyPassword ||
                !dailyPasswordConfirm) {
                notifyElement.html(`<div class="alert alert-danger alert-dismissible bg-danger text-white border-0 fade show" role="alert">
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                            Vui lòng điền đầy đủ thông tin.
                        </div>`);
                return;
            }

            if (dailyPassword !== dailyPasswordConfirm) {
                notifyElement.html(`<div class="alert alert-danger alert-dismissible bg-danger text-white border-0 fade show" role="alert">
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                            2 mật khẩu không khớp.
                        </div>`);
                return;
            }

            $.ajax({
                "url": `<%=dataPage.config.API_SERVER%>/cms-account/change-password/${id}`,
                "method": "POST",
                "timeout": 0,
                "headers": {
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                "data": {
                    newPassword: dailyPassword,
                    newPasswordConfirm: dailyPasswordConfirm
                }
            }).then((response) => {
                if (response.status) {
                    notifyElement.html(`<div class="alert alert-danger alert-dismissible bg-success text-white border-0 fade show" role="alert">
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                                Đổi mật khẩu thành công!
                            </div>`);
                    return;
                } else {
                    notifyElement.html(`<div class="alert alert-danger alert-dismissible bg-danger text-white border-0 fade show" role="alert">
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                                ${response.msg}
                            </div>`);
                    return;
                }
            }).catch((err) => {
                console.log(err);
                notifyElement.html(`<div class="alert alert-danger alert-dismissible bg-danger text-white border-0 fade show" role="alert">
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                                ${err.statusText}
                            </div>`);
                return;
            });
        }


    </script>



    <%- include('../../includes/footer') %>