<%- include('../../../includes/header') %>

    <style>
        html {
            scroll-behavior: smooth
        }

        .iframe-player {
            width: 100%;
            height: 100%;
            border-radius: 5px;
        }

        .iframe-player-container {
            aspect-ratio: 16 / 9;
            width: 100%;
        }

        .card {
            position: relative;
            display: flex;
            flex-direction: column;
            min-width: 0;
            word-wrap: break-word;
            background-color: #fff;
            background-clip: border-box;
            border: 1px solid;
            border-radius: 0;
        }

        .mr-5 {
            margin-left: 5px;
        }

        .ml-5 {
            margin-right: 5px;
        }
        #dice-set-hover {
            transition: transform .2s;
            cursor: pointer;
        }

        #dice-set-hover:hover {
            transform: scale(1.2)
        }

        .dice-result {
            transition: transform .2s;
        }

        .dice-result:focus {
            transform: scale(1.2)
        }
    </style>


