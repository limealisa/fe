<%- include('../../includes/header') %>
    <div id="elementModal"> </div>
    <div class="container-fluid">
        <!-- -------------------------------------------------------------- -->
        <!-- Start Page Content -->
        <!-- -------------------------------------------------------------- -->
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header border-bottom title-part-padding d-flex align-items-center">
                        <h4 class="card-title"><%=dataPage.title%></h4>
                        <div class="card-actions ms-auto d-flex button-group">
                          <a class="mb-0 btn-minimize link d-flex align-items-center" data-action="expand">
                            <i class="ri-fullscreen-line fs-6"></i>
                          </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <form action="" method="get" class="form-body row">
                                <div class="col-md-12 row" style="margin-bottom:10px;">
                                    <div class="col-md-2 row" style="margin-bottom: 10px;">
                                        <div class="input-group">
                                            <input type="text" name="from" class="form-control mydatepicker"
                                                placeholder="mm/dd/yyyy">
                                            <span class="input-group-text">
                                                <i class="fas fa-calendar-alt"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-2 row" style="margin-bottom: 10px;">
                                        <div class="input-group">
                                            <input type="text" name="to" class="form-control mydatepicker"
                                                placeholder="mm/dd/yyyy">
                                            <span class="input-group-text">
                                                <i class="fas fa-calendar-alt"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-1 row">
                                        <button type="submit" type="button" class="btn waves-effect waves-light btn-secondary"
                                            style="height: 30px;margin-top: 2px;">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </div>
                                    <div class="row col-md-7 justify-content-end">
                                        <div class="col-md-2 ml-auto">
                                            <div class="thongke-text" style="min-width: 125px;padding: 0.15rem 0.35rem; font-size: 0.675rem;">
                                                Tổng cược: <o id="total-bet"><%=dataPage.helpers.numberWithCommas(dataApi.dataCount.totalBet);%></o>
                                            </div>
                                        </div>
                                        <div class="col-md-2 ml-auto">
                                            <div class="thongke-text" style="min-width: 125px;padding: 0.15rem 0.35rem; font-size: 0.675rem;">
                                                Tổng cược hợp lệ: <o id="total-bet-valid"><%=dataPage.helpers.numberWithCommas(dataApi.dataCount.totalValidBet);%></o>
                                            </div>
                                        </div>
                                        <div class="col-md-2 ml-auto">
                                            <div class="thongke-text" style="min-width: 125px;padding: 0.15rem 0.35rem; font-size: 0.675rem;">
                                                Tổng thắng: <o id="total-profit"><%=dataPage.helpers.numberWithCommas(dataApi.dataCount.totalWinAmount);%></o>
                                            </div>
                                        </div>
                                        <div class="col-md-2 ml-auto">
                                            <div class="thongke-text" style="min-width: 125px;padding: 0.15rem 0.35rem; font-size: 0.675rem;">
                                                Tổng lãi/lỗ: <o id="total-profit"><%=dataPage.helpers.numberWithCommas(dataApi.dataCount.totalNetPnl);%></o>
                                            </div>
                                        </div>              
                                        <div class="col-md-2 ml-auto">
                                            <div class="thongke-text" style="min-width: 125px;padding: 0.15rem 0.35rem; font-size: 0.675rem;">
                                                Tổng hoàn trả: <o id="total-profit"><%=dataPage.helpers.numberWithCommas(dataApi.dataCount.totalAmountRefurn);%></o>
                                            </div>
                                        </div>           
                                    </div>
                                </div>
                                <div class="col-lg-10 row">
                                    <!-- <div class="col-md-3">
                                        <div class="input-group mb-3">
                                            <span class="input-group-text" id="basic-addon1">Mã Giao Dịch</span>
                                            <input type="text" class="form-control" name="transid"
                                                placeholder="SEX002BAC-40448738141..." aria-describedby="basic-addon1">
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="input-group mb-3">
                                            <span class="input-group-text" id="basic-addon1">Mã Phiên Chơi</span>
                                            <input type="text" class="form-control" name="round"
                                                placeholder="Mexico-03-GA509080022..." aria-describedby="basic-addon1">
                                        </div>
                                    </div> -->
                                    <div class="col-md-3">
                                        <div class="input-group mb-3">
                                            <span class="input-group-text" id="basic-addon1">Người chơi</span>
                                            <input type="text" class="form-control" name="username"
                                                placeholder="conmeo9999..." aria-describedby="basic-addon1">
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="input-group mb-3">
                                            <span class="input-group-text" id="basic-addon1">Loại trò chơi</span>
                                            <select class="form-control form-select" name="gameCategory"
                                                data-placeholder="Choose a Category" tabindex="1"
                                                aria-describedby="basic-addon1">
                                                <option value="">Tất Cả</option>
                                                <option value="LIVE">Casino</option>
                                                <option value="RNG">Nổ Hũ</option>
                                                <option value="SPORTS">Thể Thao</option>
                                                <option value="FISH">Bắn Cá</option>
                                                <option value="LOTTERY">Xổ Số</option>
                                            </select>
                                        </div>
                                    </div>
                                    <!-- <div class="col-md-3">
                                        <div class="input-group mb-3">
                                            <span class="input-group-text" id="basic-addon1">Mã Trò chơi</span>
                                            <input type="text" class="form-control" name="game"
                                                placeholder="SEX002, DG001..." aria-describedby="basic-addon1">
                                        </div>
                                    </div> -->
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-info align-items-center">
                                        <i class="fa fa-search"></i> Tìm kiếm
                                    </button>
                                    <button type="button" class="btn btn-info align-items-center">
                                        <i class="fa fa-users"></i> Tổng: <%=dataApi.total%>
                                    </button>
                                </div>
                            </form>
                        </div>
                        <div class="table-responsive">
                            <table id="table-container" class="table customize-table table-bordered mb-10 v-middle">
                                <thead class="bg-primary text-white">
                                    <tr>
                                        <th>#ID</th>
                                        <th>Tên Đăng Nhập</th>
                                        <th>Loại Trò Chơi</th>
                                        <th class="text-center">Tổng Cược</th>
                                        <th class="text-center">Cược Hợp Lệ</th>
                                        <th class="text-center">Tổng Thắng</th>
                                        <th class="text-center">Lãi/Lỗ</th>
                                        <th class="text-center">% Hoàn Trả</th>
                                        <th class="text-center">Tiền Hoàn Trả</th>
                                        <th class="text-center">Bắt đầu hoàn trả</th>
                                        <th class="text-center">Kết thúc hoàn trả</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if(dataApi.dataExport.length> 0) { %>

                                        <% dataApi.dataExport.forEach((data)=> {
                                            let GAMECATEGORY = {
                                                "LIVE": "Casino",
                                                "RNG": "Nổ Hũ",
                                                "SPORTS": "Thể Thao",
                                                "FISH": "Bắn Cá",
                                                "LOTTERY": "Xổ Số"
                                            };

                                            %>
                                            <tr>
                                                <td>
                                                    #<%=data.id%>
                                                </td>
                                                <td>
                                                    <%=data.userInfo.username.toUpperCase()%>
                                                </td>
                                                <td>
                                                    <%=GAMECATEGORY[data.gameCategory]%>
                                                </td>
                                                <td class="text-center">
                                                    <%=dataPage.helpers.numberWithCommas(data.betAmount)%>
                                                </td>
                                                <td class="text-center">
                                                    <%=dataPage.helpers.numberWithCommas(data.validBetAmount)%>
                                                </td>
                                                <td class="text-center">
                                                    <%=dataPage.helpers.numberWithCommas(data.winAmount)%>
                                                </td>
                                                <td class="text-center">
                                                    <%=dataPage.helpers.numberWithCommas(data.netPnl)%>
                                                </td>
                                                <td class="text-center">
                                                    <%=data.percentReturn%>%
                                                </td>
                                                <td class="text-center">
                                                    <%=dataPage.helpers.numberWithCommas(data.amountReturn)%>
                                                </td>
                                                <td class="text-center">
                                                    <%= dataPage.helpers.moment(data.timeFrom).format("H:mm:s DD/MM/YYYY") %>
                                                </td>
                                                <td class="text-center">
                                                    <%= dataPage.helpers.moment(data.timeTo).format("H:mm:s DD/MM/YYYY") %>
                                                </td>
                                            </tr>
                                            <% }); %>
                                                <% } %>
                                </tbody>
                            </table>
                        </div>
                        <div class="bootstrap-pagination">
                            <nav>
                                <ul class="pagination justify-content-center" id="phantrangUser"></ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <!-- row -->
        <!-- -------------------------------------------------------------- -->
        <!-- End PAge Content -->
        <!-- -------------------------------------------------------------- -->
    </div>
    <script>
        $(document).ready(() => {
            $('#table-container').DataTable({
                paging: false,
                searching: false,
                info: false,
                order: [[0, 'desc']],       
            });
            const urlParams = new URLSearchParams(window.location.search);
            $('input[name="from"]').val(urlParams.get('from') ? urlParams.get('from') : moment().format("DD/MM/YYYY"));
            $('input[name="to"]').val(urlParams.get('to') ? urlParams.get('to') : moment().format("DD/MM/YYYY"));
    
            // Date Picker  
            $('input[name="from"]').datepicker({
                language: 'vi',
                autoclose: true,
                todayHighlight: true,
            });
            $('input[name="to"]').datepicker({
                language: 'vi',
                autoclose: true,
                todayHighlight: true,
            });

            if (urlParams.get('username')) {
                $("input[name='username']").val(urlParams.get('username'));
            }
        });

        const phantrang = Pagination('<%=dataApi.page%>', '<%=dataApi.total%>', '<%=dataApi.kmess%>');
        const urlSearchParams = new URLSearchParams(window.location.search);
        urlSearchParams.delete("page");
        urlSearchParams.delete("limit");
        let phantrangBody = '';
        phantrang.forEach((page) => {
            $("#phantrangUser").html(phantrangBody);
            let active = ('<%=dataApi.page%>' == page) ? "active" : "";
            const urlToPage = (page !== "...") ? `/game/bet-return?page=${page}&limit=<%=dataApi.kmess%>&${urlSearchParams.toString()}` : `javascript:void(0)`;
            phantrangBody += `
                <li class="page-item ${active}">
                    <a class="page-link" href="${urlToPage}"><b>${page}</b></a>
                </li>
            `;
            $("#phantrangUser").html(phantrangBody);
        });

        const deleteDailyConfirm = (id) => {
            cuteAlert({
                type: "question",
                title: "Hành Động",
                message: "Bạn có muốn xóa nó không?",
                confirmText: "Đồng ý",
                cancelText: "Hủy"
            }).then((e) => {
                if (e == 'confirm') {
                    $.ajax({
                        "url": '<%=dataPage.config.API_SERVER%>/user/delete/' + id,
                        "method": "GET",
                        "timeout": 0,
                        "headers": {
                            "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                        },
                    }).then((response) => {
                        if (response.status) {
                            toastr.success(
                                "Thành công.",
                                "Success!"
                            );
                            setTimeout(() => {
                                window.location = "";
                            }, 700);
                        } else {
                            toastr.error(
                                response.msg,
                                "Error!"
                            );
                        }
                    }).catch((err) => {
                        console.log(err);
                        toastr.error(
                            err.responseJSON.msg,
                            "Error!"
                        );
                    });

                }
            });
        }

        const showFormUpdateRecord = (id) => {
            $.ajax({
                "url": '<%=dataPage.config.API_SERVER%>/deposit/deposit-info/' + id,
                "method": "GET",
                "timeout": 0,
                "headers": {
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                },
            }).then((response) => {
                if (response.status) {
                    $('#elementModal').html(`
                    <div class="modal fade" id="depositInfo-update-modal" tabindex="-1" aria-labelledby="exampleModalLabel1">
                        <div class="modal-dialog modal-sm" role="document">
                            <div class="modal-content">
                                <div class="modal-header d-flex align-items-center">
                                    <h4 class="modal-title" id="exampleModalLabel1">
                                        Cập nhật yêu cầu nạp tiền
                                    </h4>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <form>
                                        <div class="mb-3">
                                            <label for="recipient-name" class="control-label">Tên người chơi:</label>
                                            <input type="text" class="form-control" id="update-username" readonly />
                                        </div>
                                        <div class="mb-3">
                                            <label for="recipient-name" class="control-label">Số dư hiện tại:</label>
                                            <input type="number" class="form-control" id="update-coin" readonly />
                                        </div>
                                        <div class="mb-3">
                                            <label for="recipient-name" class="control-label">Số tiền nạp:</label>
                                            <input type="number" class="form-control" id="update-amount" readonly />
                                        </div>
                                        <div class="mb-3">
                                            <label for="recipient-name" class="control-label">Trạng thái yêu cầu:</label>
                                            <select class="form-control form-select" id="update-status"></select>
                                        </div>
                                    </form>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="
                        btn btn-light-danger
                        text-danger
                        font-weight-medium
                        " data-bs-dismiss="modal">
                                        Close
                                    </button>
                                    <button type="button" class="btn btn-success" onclick="updateDeposit('${id}')">
                                        Cập nhật
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    `);

                    $('#update-username').val(response.data.userInfo.username);
                    $('#update-coin').val(numberWithCommas(response.data.userInfo.coin));
                    $('#update-amount').val(response.data.amount);

                    if (response.data.status == "success") {
                        $('#update-status').append(`<option value="success">Thành công</option>`);
                        $('#update-status').append(`<option value="pending">Chờ duyệt</option>`);
                        $('#update-status').append(`<option value="error">Thất bại</option>`);
                    } else if (response.data.status == "pending") {
                        $('#update-status').append(`<option value="pending">Chờ duyệt</option>`);
                        $('#update-status').append(`<option value="success">Thành công</option>`);
                        $('#update-status').append(`<option value="error">Thất bại</option>`);
                    } else if (response.data.status == "error") {
                        $('#update-status').append(`<option value="error">Thất bại</option>`);
                        $('#update-status').append(`<option value="pending">Chờ duyệt</option>`);
                        $('#update-status').append(`<option value="success">Thành công</option>`);
                    }
                    $('#depositInfo-update-modal').modal('toggle');
                } else {
                    toastr.error(
                        response.msg,
                        "Error!"
                    );
                }
            }).catch((err) => {
                console.log(err);
                toastr.error(
                    err.responseJSON.msg,
                    "Error!"
                );
            });
        }

        const updateDeposit = (id) => {
            const status = $('#update-status').val();

            $.ajax({
                "url": "<%=dataPage.config.API_SERVER%>/deposit/update/" + id,
                "method": "POST",
                "timeout": 0,
                "headers": {
                    "Content-Type": "application/json",
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                },
                "data": JSON.stringify({
                    status
                }),
            }).done(function (response) {
                if (response.status) {
                    toastr.success(
                        response.msg,
                        "Success!"
                    );
                    setTimeout(() => {
                        window.location = "";
                    }, 700);
                } else {
                    toastr.error(
                        response.msg,
                        "Error!"
                    );
                }
            });
        }
    </script>
    <%- include('../../includes/footer') %>