                                            <th class="border-bottom border-top text-center">Xúc Xắc</th>
                                            <th class="border-bottom border-top text-center">Tổng Cược</th>
                                            <th class="border-bottom border-top text-center">Tổng Thắng</th>
                                            <th class="border-bottom border-top text-center">Tổng Thua</th>
