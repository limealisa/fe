        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header border-bottom title-part-padding d-flex align-items-center">
                        <h4 class="card-title">Lịch Sử Trò Chơi</b></h4>
                        <div class="card-actions ms-auto d-flex button-group">
