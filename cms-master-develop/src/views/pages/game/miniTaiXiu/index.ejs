                                        </tr>
                                    </thead>
                                    <tbody id="table-history-session"></tbody>
                                </table>
                                <nav class="text-center">
                                    <ul class="pagination mt-3 text-center align-items-center justify-content-center"
                                        id="history-session-pagination"></ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

