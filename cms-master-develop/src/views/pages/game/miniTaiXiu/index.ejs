<%- include('../../../includes/header') %>

    <style>
        html {
            scroll-behavior: smooth
        }

        .card {
            position: relative;
            display: flex;
            flex-direction: column;
            min-width: 0;
            word-wrap: break-word;
            background-color: #fff;
            background-clip: border-box;
            border: 1px solid;
            border-radius: 0;
        }

        .mr-5 {
            margin-left: 5px;
        }

        .ml-5 {
            margin-right: 5px;
        }

        .icon-result {
            width: 73px;
            height: 73px;
            border: 3px solid;
            border-radius: 50px;
        }

        .icon-result.tai {
            border-color: #565656;
            background-color: #454545;
        }

        .icon-result.xiu {
            border-color: #565656;
            background-color: #d6d6d6;
        }

        #dice-set-hover {
            transition: transform .2s;
            cursor: pointer;
        }

        #dice-set-hover:hover {
            transform: scale(1.2)
        }

        .dice-result {
            transition: transform .2s;
        }

        .dice-result:focus {
            transform: scale(1.2)
        }
    </style>


