<%- include('../../includes/header') %>
    <div id="elementModal"> </div>
    <div class="container-fluid">
        <!-- -------------------------------------------------------------- -->
        <!-- Start Page Content -->
        <!-- -------------------------------------------------------------- -->
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header border-bottom title-part-padding d-flex align-items-center">
                        <h4 class="card-title"><%=dataPage.title%></h4>
                        <div class="card-actions ms-auto d-flex button-group">
                          <a class="mb-0 btn-minimize link d-flex align-items-center" data-action="expand">
                            <i class="ri-fullscreen-line fs-6"></i>
                          </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- <h6 class="card-subtitle mb-3">
                            <code>Chỉ chỉnh sửa khi biết rõ mình đang làm gì!</code>
                        </h6> -->
                        <div class="row">
                            <form action="" method="get" class="form-body row">
                                <div class="col-lg-10 row">
                                    <div class="col-md-3">
                                        <div class="input-group mb-3">
                                            <span class="input-group-text" id="basic-addon1">Phiên trò chơi</span>
                                            <input type="text" class="form-control" name="session"
                                                placeholder="185332213..." aria-describedby="basic-addon1">
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="input-group mb-3">
                                            <span class="input-group-text" id="basic-addon1">Số tiền cược</span>
                                            <input type="text" class="form-control" name="amount"
                                                placeholder="50000" aria-describedby="basic-addon1">
                                        </div>
                                    </div>
                                    <!-- <div class="col-md-3">
                                        <div class="input-group mb-3">
                                            <span class="input-group-text" id="basic-addon1">Mã Trò chơi</span>
                                            <input type="text" class="form-control" name="game"
                                                placeholder="SEX002, DG001..." aria-describedby="basic-addon1">
                                        </div>
                                    </div> -->
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-info align-items-center">
                                        <i class="fa fa-search"></i> Tìm kiếm
                                    </button>
                                    <button type="button" class="btn btn-info align-items-center">
                                        <i class="fa fa-users"></i> Tổng: <%=dataApi.total%>
                                    </button>
                                </div>
                            </form>
                        </div>
                        <div class="table-responsive">
                            <table id="table-container" class="table customize-table table-bordered mb-10 v-middle">
                                <thead class="bg-primary text-white">
                                    <tr>
                                        <th class="">UID</th>
                                        <th class="">Người chơi</th>
                                        <th class="">Phiên cược</th>
                                        <th class="text-center">Cược chẵn</th>
                                        <th class="text-center">Cược lẻ</th>
                                        <th class="text-center">3 Trắng</th>
                                        <th class="text-center">4 Trắng</th>
                                        <th class="text-center">3 Đỏ</th>
                                        <th class="text-center">4 Đỏ</th>
                                        <th class="text-center">Tổng thắng</th>
                                        <th class="text-center">Tổng thua</th>
                                        <th class="text-center">Thời gian đặt cược</th>
                                    </tr>
                                </thead>            
                                <tbody>
                                    <% if(dataApi.dataExport.length> 0) { %>

                                        <% dataApi.dataExport.forEach((data)=> { %>
                                            <tr>
                                                <td class="">
                                                    <%= data.user_info.id %>
                                                </td>
                                                <td class="">
                                                    <%= data.user_info.username %>
                                                </td>
                                                <td class="">
                                                    <%= data.session_info.id %>
                                                </td>
                                                <td class="text-center">
                                                    <%=dataPage.helpers.numberWithCommas(data.even)%>
                                                </td>
                                                <td class="text-center">
                                                    <%=dataPage.helpers.numberWithCommas(data.odd)%>
                                                </td>
                                                <td class="text-center">
                                                    <%=dataPage.helpers.numberWithCommas(data.white3)%>
                                                </td>
                                                <td class="text-center">
                                                    <%=dataPage.helpers.numberWithCommas(data.white4)%>
                                                </td>
                                                <td class="text-center">
                                                    <%=dataPage.helpers.numberWithCommas(data.red3)%>
                                                </td>
                                                <td class="text-center">
                                                    <%=dataPage.helpers.numberWithCommas(data.red4)%>
                                                </td>
                                                <td class="text-center">
                                                    <%=dataPage.helpers.numberWithCommas(data.total_win)%>
                                                </td>
                                                <td class="text-center">
                                                    <%=dataPage.helpers.numberWithCommas(data.total_lose)%>
                                                </td>
                                                <td class="text-center">
                                                    <%= dataPage.helpers.moment(data.createdAt).format("H:mm:s DD/MM/YYYY") %>
                                                </td>
                                            </tr>
                                            <% }); %>
                                                <% } %>
                                </tbody>
                            </table>
                        </div>
                        <div class="bootstrap-pagination">
                            <nav>
                                <ul class="pagination justify-content-center" id="phantrangUser"></ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <!-- row -->
        <!-- -------------------------------------------------------------- -->
        <!-- End PAge Content -->
        <!-- -------------------------------------------------------------- -->
    </div>
    <script>
        $('#table-container').DataTable({
            paging: false,
            searching: false,
            info: false,
            order: [[0, 'desc']],
        });
        
        const phantrang = Pagination('<%=dataApi.page%>', '<%=dataApi.total%>', '<%=dataApi.kmess%>');
        const urlSearchParams = new URLSearchParams(window.location.search);
        urlSearchParams.delete("page");
        urlSearchParams.delete("limit");
        let phantrangBody = '';
        phantrang.forEach((page) => {
            $("#phantrangUser").html(phantrangBody);
            let active = ('<%=dataApi.page%>' == page) ? "active" : "";
            const urlToPage = (page !== "...") ? `/game/mini-xocdia/user-history/<%=dataPage.request.params.id%>?page=${page}&limit=<%=dataApi.kmess%>&${urlSearchParams.toString()}` : `javascript:void(0)`;
            phantrangBody += `
                <li class="page-item ${active}">
                    <a class="page-link" href="${urlToPage}"><b>${page}</b></a>
                </li>
            `;
            $("#phantrangUser").html(phantrangBody);
        });
    </script>
    <%- include('../../includes/footer') %>