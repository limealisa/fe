                    "Error!"
                );
                return;
            }

            blockUI(true);
            $.ajax({
                "url": '<%=dataPage.config.API_SERVER%>/user/create-user-incentive-donate/' + id,
                "method": "POST",
                "timeout": 0,
                "headers": {
                    "Content-Type": "application/json",
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                },
                "data": JSON.stringify({
                    id: Number(id),
                    password2: code,
                    coin: coin,
                    note: note
                })
            }).then((response) => {
                if (response.status) {
                    toastr.info(
                        response.msg,
                        "Cập nhật thành công!"
                    );
                } else {
                    toastr.error(
                        response.msg,
                        "Error!"
                    );
                }
                blockUI(false);
            });
        }

