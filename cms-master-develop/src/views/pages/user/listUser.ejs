        const updateUser = (id) => {
            const agency = $('#update-agency').val() ? $('#update-agency').val() : null;
            const name = $('#update-name').val();
            const username = $('#update-username').val();
            const email = $('#update-email').val();
            const phone = $('#update-phone').val();
            const coin = getOnlyNumberInString($('#update-coin').val());
            const status = $('#update-status').val();
            const verify = $('#update-verify').val();
            const role = $('#update-role').val();
            const withdrawCondBet = getOnlyNumberInString($('#update-withdraw-condition-bet-numb').val()) >> 0;
            const withdrawCondCoin = getOnlyNumberInString($('#update-withdraw-condition-coin-numb').val()) >> 0;

            if (!name || !username || !email || !phone || !coin || !role) {
                toastr.error(
                    "Vui lòng điền đầy đủ thông tin!",
                    "Error!"
                );
                return;
            }

            if (Number(coin) < 0) {
                toastr.error(
                    "Số dư không hợp lệ!",
                    "Error!"
                );
                return;
            }

            $.ajax({
                "url": "<%=dataPage.config.API_SERVER%>/user/update/" + id,
                "method": "POST",
                "timeout": 0,
                "headers": {
                    "Content-Type": "application/json",
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                },
                "data": JSON.stringify({
                    agency,
                    name,
                    username,
                    email,
                    phone,
                    coin: Number(coin),
                    status,
                    verify: JSON.parse(verify),
                    role,
                    withdrawCondBet: withdrawCondBet,
                    withdrawCondCoin: withdrawCondCoin
                }),
            }).done(function (response) {
                if (response.status) {
                    toastr.success(
                        response.msg,
                        "Success!"
                    );
                    setTimeout(() => {
                        //window.location = "";
                    }, 700);
                } else {
                    toastr.error(
                        response.msg,
                        "Error!"
                    );
                }
            });
        }

        const getProfitUser = (id) => {
            const from = $('input[name="from"]').val();
            const to = $('input[name="to"]').val();
            blockUI(true);
            $.ajax({
                "url": '<%=dataPage.config.API_SERVER%>/user/user-profit/' + id + '?from='+from+'&to='+to,
                "method": "GET",
                "timeout": 0,
                "headers": {
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                },
            }).then((response) => {
                if (response.status) {
                    const data = response.data;
                    let totalDeposit = 0;
                    let totalWithdraw = 0;
                    let totalDepositCount = 0;
                    let totalWithdrawCount = 0;

                    let totalRefurn = 0;
                    let totalProfit = 0;
                    let totalBetValid = 0;
                    let totalWin = 0;
                    let totalLose = 0;
                    let totalIncentive = 0;

                    data.finan.map((row) => {
                        if (row.type == "recharge" && row.status == "success") {
                            totalDepositCount++;
                            totalDeposit += row.amount;
                        };
                        if (row.type == "cashout" && row.status == "success") {
                            totalWithdrawCount++;
                            totalWithdraw += row.amount;
                        };
                    });

                    data.bet.map((row) => {
                        totalBetValid += row.validBetAmount * 1000;
                        if (row.netPnl > 0) totalWin += row.netPnl;
                        if (row.netPnl < 0) totalLose += row.netPnl;
                    });

                    data.refurn.map((row) => {
                        totalRefurn += row.amountReturn;
                    });

                    data.incentive.map((row) => {
                        totalIncentive += row.amount;
                    });

                    totalProfit = totalDeposit - totalWithdraw - totalRefurn - totalIncentive;

                    $("#total-deposit").html(numberWithCommas(totalDeposit));
                    $("#total-witdraw").html(numberWithCommas(totalWithdraw));
                    $("#total-deposit-count").html(numberWithCommas(totalDepositCount));
                    $("#total-withdraw-count").html(numberWithCommas(totalWithdrawCount));

                    $("#total-profit").html(numberWithCommas(totalProfit));
                    $("#total-bet-valid").html(numberWithCommas(totalBetValid));
                    $("#total-win").html(numberWithCommas(totalWin));
                    $("#total-lose").html(numberWithCommas(totalLose));
                    $("#total-refurn").html(numberWithCommas(totalRefurn));
                    $("#total-incentive").html(numberWithCommas(totalIncentive));
                }else {
                    console.log(response);
                    toastr.error(
                        response.msg,
                        "Error!"
                    );
                }
                blockUI(false);
            });
        }
        
