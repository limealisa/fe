    <script>
        let isRedirect = false;
        $(document).ready(() => {
            //getListManualBank();
        });

        const showContent = (target) => {
            let arrTabElem = ['deposit-manual', 'deposit-auto', 'fund'];
            arrTabElem.forEach((id) => {
                let elementMenuProperti = $('#tab-menu-' + id);
                let elementContentProperti = $('#tab-content-' + id);

                if (target == id) {
                    elementMenuProperti.addClass("active");
                    elementContentProperti.fadeIn();
                } else {
                    elementMenuProperti.removeClass("active");
                    elementContentProperti.hide();
                }
            });
            if (target == 'deposit-manual') {
                $('#deposit-list-show').fadeOut();
                $('#selectDepositType').fadeIn();
            };
            //if (target == 'deposit-auto') null;
        }

        const depositType1 = () => {
            isRedirect = false;
            $('#selectDepositType').fadeOut();
            $('#deposit-list-show').html(``);
            $('#deposit-list-show').fadeIn();
            getListManualBank();
        }

        const depositTypeQr = () => {
            isRedirect = true;
            $('#selectDepositType').fadeOut();
            $('#deposit-list-show').html(``);
            $('#deposit-list-show').fadeIn();
            getListManualBank();
        }

        const depositTypeCustom = () => {
            isRedirect = false;
            $('#selectDepositType').fadeOut();
            showBodyRequestManualBank('CUSTOM', 'CUSTOM PAYMENT');
        }

        const depositTypeCustomQr = () => {
            isRedirect = true;
            $('#selectDepositType').fadeOut();
            showBodyRequestManualBank('CUSTOM', 'CUSTOM PAYMENT');
        }


        const depositTypeMomo = () => {
            $('#selectDepositType').fadeOut();
            showBodyRequestManualBank('MOMO', 'MOMO PAYMENT');
        }

        const depositTypeCard = () => {
            isRedirect = false;
            $('#selectDepositType').fadeOut();
            $('#body-list-manual-bank').hide();
            $('#body-request-manual-card').show();
            getDataCard();
        }

        const getListManualBank = () => {
            $.ajax({
                "url": "<%=dataPage.config.MAIN_API%>/api/payment/getListAutoBankDeposit",
                "method": "GET",
                "timeout": 0,
                "headers": {
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                    "Content-Type": "application/json",
                },
            }).done((response) => {
                if (response.status) {
                    const ListManualBank = response.data;

                    ListManualBank.forEach((item) => {
                        $('#deposit-list-show').append(`
                            <div class="deposit-list-item DEBIT_CARD"
                                onclick="showBodyRequestManualBank('${item.code}', '${item.shortName.toUpperCase()}')">
                                <h3>${item.shortName.toUpperCase()}</h3><small>50~1,000,000</small>
                            </div>
                        `);
                    });
                } else {
                    alert(response.msg);
                }
            });
        }

        const getListBankDeposit = () => {
            $.ajax({
                "url": "<%=dataPage.config.MAIN_API%>/api/payment/getListBankDeposit",
                "method": "GET",
                "timeout": 0,
                "headers": {
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                    "Content-Type": "application/json",
                },
            }).done((response) => {
                if (response.status) {
                    const ListBankDeposit = response.data;
                    for (const item of ListBankDeposit) {
                        $('#bankDeposit').append(`
                    <option value="${item.code}">Ngân hàng ${item.code}</option>
                    `);
                    }

                } else {
                    alert(response.msg);
                }
            });
        }

        const showBodyRequestManualBank = (bankId, name) => {
            $('#body-list-manual-bank').hide();
            $(".mc-detail").hide();
            // $('#body-request-manual-bank').fadeIn();
            $('.hiddenCode').html(bankId);
            $('#bankProvide').html(bankId);

            $('#body-list-manual-bank').hide();
            $('#body-request-manual-bank').fadeIn();

            // $.ajax({
            // "url": "<%=dataPage.config.MAIN_API%>/api/payment/getDataRequestManualBank/" + bankId,
            // "method": "GET",
            // "timeout": 0,
            // "headers": {
            // "Authorization": "Bearer <%=dataPage.session.accessToken%>",
            // "Content-Type": "application/json",
            // },
            // }).done((response) => {
            // if (response.status) {
            // const data = response.data;

            // $('#body-list-manual-bank').hide();
            // $('#body-request-manual-bank').fadeIn();

            // $('#bankProvide').html(data.bankProvide.toUpperCase());
            // $('#bankName').html(data.bankName.toUpperCase());
            // $('#bankNumber').html(data.bankNumber);
            // $('#content').html(data.content.toUpperCase());
            // getListBankDeposit();
            // } else {
            // alert(response.msg);
            // }
            // });
        }

        const clickBack = () => {
            if ($('.hiddenCode').html() == 'momo') {
                $('#body-request-manual-bank').hide();
                $('#body-list-manual-bank').fadeIn();
                $('#selectDepositType').fadeIn();
                $('#hiddenCode').html(``);
                clearBody();
            } else {
                $('#deposit-list-show').html('');
                $('#body-list-manual-bank').fadeIn();
                $('#body-request-manual-bank').hide();
                $('#hiddenCode').html(``);
                clearBody();
                getListManualBank();
            }

        }

        const clickBackCard = () => {
            $('#body-request-manual-card').hide();
            $('#body-list-manual-bank').fadeIn();
            $('#selectDepositType').fadeIn();
            clearBodyCard();
        }

        const coppyToClipboard = (text) => {
            var input = document.createElement('input');
            input.setAttribute('value', text);
            document.body.appendChild(input);
            input.select();
            var result = document.execCommand('copy');
            document.body.removeChild(input);
            return toastr.success(
                'Đã copy vào bộ nhớ tạm!',
                "Thành công!"
            );
            return result;
        }

        const onChangerCoin = () => {
            const inputCoin = $('#amountDeposit');
            const elementShowChanged = $('.mc-input-convert-amount');

            if (Number(inputCoin.val()) > 0) {
                const xcoin = Number(inputCoin.val()) * 1000;
                elementShowChanged.html(`= ${numberWithCommas(xcoin)} VND`);
                inputCoin.val(Number(inputCoin.val()));
            } else {
                toastr.error(
                    'Số tiền nạp phải là số tự nhiên lớn hơn 0',
                    "Thất bại!"
                );
                inputCoin.val("");
                elementShowChanged.html(`= 0 VND`);
            }
        }

        const getDataCard = () => {
            $.ajax({
                "url": `<%=dataPage.config.MAIN_API%>/api/payment/getListAutoCardDeposit`,
                "method": "GET",
                "timeout": 0,
                "headers": {
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>"
                },
            }).done((resp) => {
                if (resp.status) {
                    $('select[name="network"]').html(`<option value="">Vui lòng chọn nhà mạng</option>
                                    `);
                    $('select[name="amount"]').html(`<option value="">Vui lòng chọn mệnh giá</option>`);

                    resp.data.cardCode.forEach((item) => {
                        $('select[name="network"]').append(`
                                    <option value="${item.toUpperCase()}">${item.toUpperCase()}</option>
                                    `);
                    });
                    resp.data.amountValue.forEach((item) => {
                        $('select[name="amount"]').append(`
                                    <option value="${item}">${numberWithCommas(item)}</option>
                                    `);
                    });
                } else {
                    console.log(resp);
                }
            }).fail((data) => {
                alert("Hệ thống gặp lỗi bất ngờ! Vui lòng thử lại!");
            });
        };

        const confirmTransaction = () => {
            try {
                let amountDeposit = $('#amountDeposit').val();

                if (!amountDeposit) {
                    return toastr.error(
                        "Vui lòng nhập đầy đủ thông tin trước khi nạp tiền!",
                        "Thất bại!"
                    );
                }

                amountDeposit = Number(amountDeposit * 1000);

                $('#btnDeposit').prop('disabled', true);

                const entryPoint = 'createRequestAutoBank';

                $.ajax({
                    "url": `<%=dataPage.config.MAIN_API%>/api/payment/${entryPoint}`,
                    // "url": `https://api.csn365.com/api/payment/${entryPoint}`,
                    "method": "POST",
                    "timeout": 0,
                    "headers": {
                        "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                        "Content-Type": "application/json",
                    },
                    "data": JSON.stringify({
                        amount: String(amountDeposit),
                        subType: $('.hiddenCode').html(),
                    }),
                }).done(function (response) {
                    $('#btnDeposit').prop('disabled', false);
                    if (response.status) {
                        // $('#bankName').html(response.data.phoneName.toUpperCase());
                        // $('#bankNumber').html(response.data.phoneNum);
                        // $('#content').html(response.data.code);

                        if (isRedirect) {
                            alert(`Yêu cầu thành công! Nhấn để hiển thị mã QrCode!`);

                            // window.open(response.data.qr_url, '', 'width=800, height=900');
                            // window.location.reload();
                            // Swal.fire({
                            //     imageUrl: response.data.qrImageUrl,
                            //     imageHeight: 445,
                            //     imageAlt: 'Scan QrCode',
                            //     allowOutsideClick: false,
                            //     showCancelButton: false,
                            //     confirmButtonText: 'Đóng'
                            // });
                            Swal.fire({
                                title: `${response.data.bankCode} | ${response.data.bankName} | ${response.data.bankAccount}`,
                                text: `Nội dung: ${response.data.content}`,
                                imageUrl: response.data.qrImageUrl,
                                imageWidth: 400,
                                imageHeight: 400,
                                imageAlt: "Thanh toán",
                                confirmButtonText: 'Đóng'
                            });
                        } else {
                            alert(`Tạo code nạp thành công! Vui lòng chuyển khoản đến thông tin vừa được tạo!`);
                            window.open(response.data.payment_url, '', 'width=800, height=900');

                            // $('#bankName').html(response.data.bankName.toUpperCase());
                            // $('#bankNumber').html(response.data.bankAccount);
                            // $('#content').html(response.data.content);
                            // $(".mc-detail").show();
                        }
                        //clickBack();
                    } else {
                        alert(response.msg);
                    }
                });
            } catch (e) {
                console.log(e);
                alert(`Đã có lỗi xảy ra! vui lòng thử lại!`);
            }
        }

        const confirmTransactionCard = () => {
            try {
                let amount = $('select[name="amount"]').val();
                let network = $('select[name="network"]').val();
                let pin = $('input[name="pin"]').val();
                let seri = $('input[name="seri"]').val();

                if (!amount || !network || !pin || !seri) {
                    return toastr.error(
                        "Vui lòng nhập đầy đủ thông tin trước khi nạp điểm!",
                        "Thất bại!"
                    );
                }

                $('#btnDepositCard').prop('disabled', true);
                $.ajax({
                    "url": `<%=dataPage.config.MAIN_API%>/api/payment/createRequestAutoCard`,
                    "method": "POST",
                    "timeout": 0,
                    "headers": {
                        "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                        "Content-Type": "application/json",
                    },
                    "data": JSON.stringify({
                        amount: String(amount),
                        network, pin, seri
                    }),
                }).done(function (response) {
                    $('#btnDepositCard').prop('disabled', false);
                    if (response.status) {
                        return toastr.success(
                            response.msg,
                            "Thành công!"
                        );
                    } else {
                        // alert(response.msg);
                        return toastr.error(
                            response.msg,
                            "Thất bại!"
                        );
                    }
                });
            } catch (e) {
                console.log(e);
                alert(`Đã có lỗi xảy ra! vui lòng thử lại!`);
            }
        }


        const clearBody = () => {
            $('#bankName').html(``);
            $('#bankNumber').html(``);
            $('#content').html(``);
        }

        const clearBodyCard = () => {
            $('input[name="pin"]').val(``);
            $('input[name="seri"]').val(``);
        }
    </script>


    <%- include('../../includes/footer') %>