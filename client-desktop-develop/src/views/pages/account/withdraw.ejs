            <script>
                $(document).ready(() => {
                    getListBankDeposit();
                    getWithdrawCondition();
                });

                const getWithdrawCondition = () => {
                    $.ajax({
                        "url": "<%=dataPage.config.MAIN_API%>/api/payment/getWithdrawalConditions",
                        "method": "GET",
                        "timeout": 0,
                        "headers": {
                            "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                            "Content-Type": "application/json",
                        },
                    }).done((response) => {
                        $("#totalDeposit").html(numberWithCommas(response.totalDeposit));
                        $("#totalvalidBet").html(numberWithCommas(response.totalBetValid));
                    });
                }

                const showContent = (target) => {
                    let arrTabElem = ['deposit-manual', 'deposit-auto', 'fund', 'deposit-wallet'];
                    arrTabElem.forEach((id) => {
                        let elementMenuProperti = $('#tab-menu-' + id);
                        let elementContentProperti = $('#tab-content-' + id);

                        if (target == id) {
                            elementMenuProperti.addClass("active");
                            elementContentProperti.fadeIn();
                        } else {
                            elementMenuProperti.removeClass("active");
                            elementContentProperti.hide();
                        }
                    });
                    //if (target == 'deposit-manual') getInfo();
                    //if (target == 'deposit-auto') null;
                }

                const getListBankDeposit = () => {
                    $.ajax({
                        "url": "<%=dataPage.config.MAIN_API%>/api/payment/getListUserBank",
                        "method": "GET",
                        "timeout": 0,
                        "headers": {
                            "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                            "Content-Type": "application/json",
                        },
                    }).done((response) => {
                        if (response.status) {
                            const ListBankDeposit = response.data;
                            for (const item of ListBankDeposit) {
                                if (item.bankProvide == "MOMO") {
                                    $('.deposit-list[id=wallet]').append(`
                                    <div class="deposit-list-item MOMOPAY" onclick="showBodyRequestManualBank('${item.bankProvide}', '${item.bankNumber}', '${item.bankName}', '${item.bankBranch}')">
                                        <h3>${item.bankProvide}</h3><small style="color: #12a733;font-size: 11px;text-transform: lowercase;font-family: monospace;">${item.bankNumber}</small>
                                    </div>
                                `);
                                } else {
                                    $('.deposit-list[id=bank]').append(`
                                    <div class="deposit-list-item DEBIT_CARD" onclick="showBodyRequestManualBank('${item.bankProvide}', '${item.bankNumber}', '${item.bankName}', '${item.bankBranch}')">
                                        <h3>${item.bankProvide}</h3><small style="color: #12a733;font-size: 11px;text-transform: lowercase;font-family: monospace;">${item.bankNumber}</small>
                                    </div>
                                `);
                                }
                            }
                        } else {
                            alert(response.msg);
                        }
                    });
                }

                const showBodyRequestManualBank = (bankProvide, bankNumber, bankName, bankBranch) => {
                    $('#body-list-manual-bank').hide();
                    $('#body-list-manual-wallet').hide();
                    $('#body-request-manual-bank').fadeIn();
                    $('#tab-content-deposit-manual').show();
                    $('#tab-content-deposit-wallet').hide();
                    $('#bankProvide').html(bankProvide.toUpperCase());
                    $('#bankNumber').html(bankNumber.toUpperCase());
                    $('#bankName').html(bankName.toUpperCase());
                    $('#bankBranch').html(bankBranch.toUpperCase())
                }

                const clickBack = () => {
                    $('.deposit-list').html('');
                    $('#body-list-manual-bank').fadeIn();
                    $('#body-request-manual-bank').hide();
                    getListBankDeposit();
                }

                const coppyToClipboard = (text) => {
                    var input = document.createElement('input');
                    input.setAttribute('value', text);
                    document.body.appendChild(input);
                    input.select();
                    var result = document.execCommand('copy');
                    document.body.removeChild(input);
                    return toastr.success(
                        'Đã copy vào bộ nhớ tạm!',
                        "Thành công!"
                    );
                    return result;
                }

                const onChangerCoin = () => {
                    const inputCoin = $('#amountDeposit');
                    const elementShowChanged = $('.mc-input-convert-amount');

                    if (Number(inputCoin.val()) > 0) {
                        const xcoin = Number(inputCoin.val()) * 1000;
                        elementShowChanged.html(`= ${numberWithCommas(xcoin)} VND`);
                        inputCoin.val(Number(inputCoin.val()));
                    } else {
                        toastr.success(
                            'Số tiền rút tối thiểu là 100.000 VND',
                            "Thành công!"
                        );
                        inputCoin.val("");
                        elementShowChanged.html(`= 0 VND`);
                    }
                }

                const confirmTransaction = () => {
                    try {
                        let amountDeposit = $('#amountDeposit').val();
                        const bankName = $('#bankName').html();
                        const bankNumber = $('#bankNumber').html();
                        const bankProvide = $('#bankProvide').html();

                        if (!bankName ||
                            !bankNumber ||
                            !bankProvide
                        ) {
                            return toastr.error(
                                "Vui lòng nhập đầy đủ thông tin trước khi nhấn xác nhận!",
                                "Thất bại!"
                            );
                        }

                        amountDeposit = Number(amountDeposit * 1000);

                        if (amountDeposit < 100000) {
                            return toastr.error(
                                "Số tiền rút tối thiểu là 100.000 VND!",
                                "Thất bại!"
                            );
                            return;
                        }

                        $('#btnWithdraw').prop('disabled', true);
                        $.ajax({
                            "url": "<%=dataPage.config.MAIN_API%>/api/payment/createRequestWithdraw",
                            "method": "POST",
                            "timeout": 0,
                            "headers": {
                                "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                                "Content-Type": "application/json",
                            },
                            "data": JSON.stringify({
                                bankName,
                                bankNumber,
                                bankProvide,
                                amount: amountDeposit
                            }),
                        }).done(function (response) {
                            $('#btnWithdraw').prop('disabled', false);
                            if (response.status) {
                                toastr.success(
                                    response.msg,
                                    "Thành công!"
                                );
                                clickBack();
                            } else {
                                return toastr.error(
                                    response.msg,
                                    "Thất bại!"
                                );
                            }
                        });
                    } catch (e) {
                        console.log(e);
                        alert(`Đã có lỗi xảy ra! vui lòng thử lại!`);
                    }
                }


            </script>


