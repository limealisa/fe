    <script>
        let vipConfig = {};
        $(document).ready(() => {
            initVip();
        });

        function initVip() {
            getVipConfig().then((res) => {
                if (res.status) {
                    vipConfig = res.data;
                    getVipUser();
                }
            });
        }

        function getVipConfig() {
            return new Promise((resolve, reject) => {
                $.ajax({
                    url: `<%=dataPage.config.MAIN_API%>/api/vip/get-vip-config`,
                    headers: {},
                    type: "GET",
                    dataType: "json",
                    success: (result) => {

                        resolve(result);
                    },
                    error: (error) => {
                        reject(error);
                    }
                });
            });
        }

        function getReward(vipLevel) {
            $(".msg-btn").hide();
            return new Promise((resolve, reject) => {
                $.ajax({
                    url: `<%=dataPage.config.MAIN_API%>/api/vip/get-vip-reward`,
                    headers: {},
                    type: "POST",
                    timeout: 0,
                    headers: {
                        "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                        "Content-Type": "application/json",
                    },
                    dataType: "json",
                    data: JSON.stringify({
                        vip: vipLevel
                    }),
                    success: (result) => {
                        $(".msg-btn").show();
                        if (result.status) {
                            initVip();
                        }
                        return toastr.success(
                            result.msg,
                            "Thành công!"
                        );
                        resolve(result);
                    },
                    error: (error) => {
                        reject(error);
                    }
                });
            });
        }

        const getVipUser = () => {
            $.ajax({
                "url": "<%=dataPage.config.MAIN_API%>/api/vip",
                "method": "GET",
                "timeout": 0,
                "headers": {
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                    "Content-Type": "application/json",
                },
            }).done((response) => {
                if (response.status) {
                    const VipData = response.data;

                    if (VipData.vip_current == 0) {
                        $("#vip-level").addClass("vip-level-0");
                    } else {
                        if (VipData.vip_current > 10) {
                            $("#vip-level").addClass("vip-level-10");
                        } else {
                            $("#vip-level").addClass("vip-level-" + VipData.vip_current);
                        }
                    }

                    $("#coin-reward").html(numberWithCommas(VipData.coin_reward));
                    $("#coin-monthly").html(numberWithCommas(VipData.coin_monthly));

                    let totalDeposit = VipData.total_deposit;
                    let totalValidBet = VipData.total_validBet;

                    $(".level").html(`VIP ${VipData.vip_current}`);
                    $("#next_vip_level").html(`Điều kiện lên VIP ${VipData.vip_current + 1}`);
                    $("#total_deposit").html(numberWithCommas(totalDeposit));
                    $("#total_validbet").html(numberWithCommas(totalValidBet));
                    $("#deposit_require").html(numberWithCommas(vipConfig["vip" + (VipData.vip_current + 1)].deposit_require));
                    $("#validbet_require").html(numberWithCommas(vipConfig["vip" + (VipData.vip_current + 1)].valid_bet_require));

                    // $(".codition-point").html(`Còn thiếu ${numberWithCommas(vipConfig["vip" + VipData.vip_current + 1].deposit_require - VipData.total_deposit)}`)
                    $(".bottom-box").html(`
                        <p style="margin-top:5px;font-size:15px;">Thưởng thăng cấp = ${numberWithCommas(vipConfig["vip" + (VipData.vip_current + 1)].coin_reward)}</p> 
                        <p style="margin-top:5px;font-size:15px;">Thưởng tháng = ${numberWithCommas(vipConfig["vip" + (VipData.vip_current + 1)].coin_monthly)}</p> 
                        `);
                    // $(".prog-2").css("width", (totalDeposit / VipData.next_vip_deposit_require) * 100 + "%");

                    // nhận thưởng
                    if (
                        totalDeposit >= vipConfig["vip" + (VipData.vip_current + 1)].deposit_require
                        &&
                        totalValidBet >= vipConfig["vip" + (VipData.vip_current + 1)].valid_bet_require
                    ) {
                        $(".msg-btn").attr("style", "color: rgb(24 190 57);border: 1px solid rgb(24 190 57);cursor: pointer;");
                        $(".msg-btn").html(`Nhận thưởng & Thăng cấp`);
                        $(".msg-btn").addClass("shake-anim");
                        $(".msg-btn").attr("onClick", `getReward(${VipData.vip_current + 1})`);
                    }
                } else {
                    alert(response.msg);
                }
            });
        }

    </script>

