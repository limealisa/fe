            <div class="swiper-box">

                <div class="swiper-body" style="margin-bottom: 20px;">

                    <div class="swiper mySwiper">
                        <div class="swiper-wrapper">

                            <% for(var i=1; i <=60; i++) { %>
                                <div class="swiper-slide">
                                    <div class="vip-card vip-level-<%=(i >= 10) ? 10: i;%>">
