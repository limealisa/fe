    <div id="body-web-vip">
        <div class="main-wrap">
            <!-- <div class="vip-bg">
                <img class=" lazyloaded" data-src="https://i.imgur.com/GDASj10.png" alt=""
                    src="https://i.imgur.com/GDASj10.png">
