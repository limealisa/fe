        <!-- Initialize Swiper -->
        <script>
            getVipConfig().then((res) => {
                if (res.status) {
                    const vipdata = res.data;
                    let body = "";
                    let i = 1;
                    for (var key of Object.keys(vipdata)) {
                        // console.log(key + " -> " + vipdata[key]);
                        body += `<tr>`;
                        body += `<th>VIP ${i}</th>`;
                        body += `<th>${numberWithCommas(vipdata[key].valid_bet_require)}</th>`;
                        body += `<th>${numberWithCommas(vipdata[key].deposit_require)}</th>`;
                        body += `<th>${numberWithCommas(vipdata[key].coin_reward)}</th>`;
                        body += `<th>${numberWithCommas(vipdata[key].coin_monthly)}</th>`;
                        body += `</tr>`;
                        i++;
                    }
                    $("#vip-privilege-table").append(body);
                }
                var swiper = new Swiper(".mySwiper", {
                    effect: "cards",
                    grabCursor: true,
                    navigation: {
                        nextEl: ".swiper-button-next",
                        prevEl: ".swiper-button-prev",
                    },
                });
            });

            function getVipConfig() {
                return new Promise((resolve, reject) => {
                    $.ajax({
                        url: `<%=dataPage.config.MAIN_API%>/api/vip/get-vip-config`,
                        headers: {},
                        type: "GET",
                        dataType: "json",
                        success: (result) => {
                            resolve(result);
                        },
                        error: (error) => {
                            reject(error);
                        }
                    });
                });
            }
        </script>

