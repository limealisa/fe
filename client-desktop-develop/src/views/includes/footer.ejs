<script>
    const showPopup = (title, content) => {
        Swal.fire({
            title: title,
            text: content,
            icon: 'warning',
        })
    }
    let percentTransaction = "0"
    let freeTransction = percentTransaction / 100
    $('#amountTrans').on('input', function () {
        let amount = parseFloat($(this).val());
        let feeAmount = ($(this).hasClass('percent')) ? (amount + (amount * freeTransction)) : amount
        let seePercent = ($(this).hasClass('percent')) ? `+ ${percentTransaction}% ` : '';
        if (!amount) {
            $(this).parent().next().html(`${seePercent}= 0 VNĐ`);
        } else {
            $(this).parent().next().html(`${seePercent}= ${feeAmount.toLocaleString()} VNĐ`);
        }
        // $('#amountTransReal').val(amount*1000)
    })
    $('#list-amount span').on('click', function () {
        let amount = parseInt($(this).attr('data-amount'));
        $('#amountTrans').val(amount);
        $('#amountTrans').parent().next().html(`= ${(parseFloat(amount)).toLocaleString()} VNĐ`);
        // $('#amountTransReal').val(amount*1000)
    })
    $(document).on('submit', 'form#registerform', function () {
        $('.loadding').addClass('active');
    });
    $(document).on('submit', 'form#customformRecharge', function () {
        $('.loadding').addClass('active');
    });
    $('#search-bet').click(function () {
        let productName = $('#product_name').val();
        let timeStart = $('#timeStart').val();
        let timeEnd = $('#timeEnd').val();
        $.ajax({
            url: "/web/nato888/get/history/bet",
            headers: {
                "X-CSRF-TOKEN": $('meta[name="csrf-token"]').attr(
                    "content"
                ),
            },
            type: "POST",
            dataType: "json",
            data: { productName, timeStart, timeEnd },
            success: function (result) {
                $('.historyGame').html(result);
            },
        });
    })
    $('#search-history').click(function () {
        let type = $('#type').val();
        let timeStart = $('#timeStart').val();
        let timeEnd = $('#timeEnd').val();
        $.ajax({
            url: "/web/nato888/get/history-all/all",
            headers: {
                "X-CSRF-TOKEN": $('meta[name="csrf-token"]').attr(
                    "content"
                ),
            },
            type: "POST",
            dataType: "json",
            data: { type, timeStart, timeEnd },
            success: function (result) {
                $('#history-changed').html(result);
            },
        });
    })
    $('.login-none').click(function () {
        $('.popup-login').removeClass('active');
    })

    async function copyToClipboard(element) {
        let text = document.getElementById(element).value;
        await navigator.clipboard.writeText(text);
        Swal.fire({
            title: 'Sao chép thành công',
            icon: 'success',
        })
    }

    $('#maintain').click(function () {
        let start = $(this).data('start');
        let end = $(this).data('end');
        if (start != '0' && end != '0') content = `Từ ngày ${start} đến ngày ${end}`;
        if (start == '0' && end != '0') content = `Mở vào ngày ${end}`;
        if (end == '0') content = `Thời gian mở sẽ được cập nhật sau`;
        showPopup(
            'Trò chơi đang bảo trì',
            content
        );
    })
    $('.submitFormCustomerNone').click(function (e) {
        e.preventDefault();
    })
    $('.submitFormCustomer').click(function (e) {
        e.preventDefault();
        if ($('.amount_transaction').val() < 100000) {
            showPopup(
                'Tối thiểu 100,000 VNĐ',
            );
        } else if ($('.amount_transaction').val() != '') {
            $('#passTransactions').modal('show');
        }
    })
    $('#withdrawBetValid').click(function (e) {
        e.preventDefault();
        let bet_valid = $(this).data('bet');
        showPopup(
            'Chưa đạt điều kiện rút',
            `Cần cược thêm ${bet_valid} VNĐ`
        );
    })
    $('#showPopupGame').click(function () {
        $('#DIV_1').toggleClass('active');
    })
    $('#checkPassTransaction').click(function () {
        let pass_transaction = $('#pass_transaction').val();
        $.ajax({
            url: "/web/nato888/check/pass/transaction",
            headers: {
                "X-CSRF-TOKEN": $('meta[name="csrf-token"]').attr(
                    "content"
                ),
            },
            type: "POST",
            dataType: "json",
            data: { pass_transaction },
            beforeSend: function () {
                $('.loadding').addClass('active');
            },
            success: function (result) {
                if (result == 1) {
                    $('.customformTransaction').submit();
                } else {
                    showPopup(
                        'Mã bảo mật không chính xác',
                        `Vui lòng thử lại`
                    );
                    $('.loadding').removeClass('active');
                }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                console.log(xhr.status)
                console.log(thrownError)
            }
        });

    })
    flatpickr("#timeStart", {
        enableTime: true,
        dateFormat: "Y-m-d",
    });

    flatpickr("#timeEnd", {
        enableTime: true,
        dateFormat: "Y-m-d",
    });
    $('.search-history').click(function () {
        let type = $(this).data('type');
        let id = $(this).data('id');
        let gameName = $('.tab-pane.fade.active.in.show .gameName').val();
        let categoryId = $('.tab-pane.fade.active.in.show .categoryId').val();
        let timeStart = $('.tab-pane.fade.active.in.show .timeStart').val();
        let timeEnd = $('.tab-pane.fade.active.in.show .timeEnd').val();
        $.ajax({
            url: "/web/nato888/get/history/typeDK",
            headers: {
                "X-CSRF-TOKEN": $('meta[name="csrf-token"]').attr(
                    "content"
                ),
            },
            type: "POST",
            dataType: "json",
            data: { type, timeStart, timeEnd, categoryId, gameName },
            beforeSend: function () {
            },
            success: function (result) {
                $('.tab-pane.fade.active.in.show .updateHistory').html(result);
                $('.bet' + id).html(result);
                $('.menu' + id).html(result);
                $('#list-mess').html(result);
            },
            error: function (xhr, ajaxOptions, thrownError) {
                console.log(xhr.status)
                console.log(thrownError)
            }
        });
    })

    $(document).on('click', '#refreshCaptcha', function () {
        $.ajax({
            url: "/web/nato888/refereshcapcha/reload",
            type: 'get',
            dataType: 'html',
            beforeSend: function () {
                $('.loadding').addClass('active');
            },
            success: function (json) {
                console.log(json)
                // $('#basic-addon2').html(json);
                $('.captcha').html(json);
                $('.loadding').removeClass('active');
            },
            error: function (data) {
                alert('Try Again.');
                $('.loadding').removeClass('active');
            }
        });
    })

    $(document).ready(function () {
        if ($('.now-time').length > 0) {
            let options = {
                timeZone: 'asia/ho_chi_minh',
                year: 'numeric',
                month: 'numeric',
                day: 'numeric',
                hour: 'numeric',
                minute: 'numeric',
                second: 'numeric',
            },
                myDate = new Intl.DateTimeFormat([], options);

            setInterval(() => {
                $('.now-time').text(myDate.format(new Date()))
            }, 1000);
        }
    });

    $('#body-web-mess .mess-item').click(function () {
        let id = $(this).data('id');
        if (!$(this).hasClass('read-done')) {
            $(this).addClass('read-done');
            let num = $('#change-count-mess').html();
            $('#change-count-mess').html(num - 1);
        }
        $.ajax({
            url: "/web/nato888/get/info/noti",
            headers: {
                "X-CSRF-TOKEN": $('meta[name="csrf-token"]').attr(
                    "content"
                ),
            },
            type: "POST",
            dataType: "json",
            data: { id },
            beforeSend: function () {
            },
            success: function (result) {

            },
            // error: function(xhr, ajaxOptions, thrownError) {
            //     console.log(xhr.status)
            //     console.log(thrownError)
            // }
        });
    })
</script>

