<div class="popup-forgetPass" style="display: none;background-color: rgb(0 0 0 / 13%);" id="popup-news">
    <div class="forgetPass-container" style="border-radius: 12px;">
        <div class="head">
            <h2></h2>
            <h2 id="popup-news-title"></h2>
            <i class="fa-solid fa-xmark"></i>
        </div>
        <div class="body" id="popup-news-content">
            
        </div>
    </div>
</div>

<script>
    $(document).ready(() => {
        getSiteInfo().then((data) => {
            const announcement = data.announcement;
            $("#popup-news-title").html(announcement.title);
            $("#popup-news-content").html(announcement.content);
            if (announcement.isShow) {
                $('#popup-news').fadeIn();
            }
        });
    });

    const getSiteInfo = () => {
        return new Promise((resolve, reject) => {
            var settings = {
                "url": "<%=dataPage.config.MAIN_API%>/api/config/info",
                "method": "GET",
                "timeout": 0,
                "headers": { "Content-Type": "application/json" },
            };
            $.ajax(settings).done(function (response) {
                if (response.status) {
                    const data = response.data;
                    resolve(data);
                } else {
                    reject(response);
                }
            }).fail(err => {
                reject(err);
            });
        });
    }
</script>