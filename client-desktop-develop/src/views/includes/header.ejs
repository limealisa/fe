                                                    aria-required="true" aria-invalid="false">
                                            </div>
                                            <div data-v-6bfc405e="" class="form_item">
                                                <input data-v-6bfc405e="" autocomplete="new-password"
                                                    placeholder="Mật khẩu" type="password" name="password"
                                                    class="password_input" aria-required="true" aria-invalid="false">
                                            </div>
                                            <a href="javascript:void(callPopupForgotPassword(true))" data-v-6bfc405e=""
                                                class="forget_box forget-pass text-dark mr-2">Quên
                                                mật khẩu</a>
                                            <div data-v-6bfc405e="" class="join-select">
                                                <button data-v-6bfc405e="" type="submit"
                                                    style="background-image: unset;color: #ce3900;background-color: #fff;"
                                                    class="btn_join hover">
                                                    Đăng nhập
                                                </button>
                                            </div>
                                        </form>
                                        <div data-v-6bfc405e="" class="join-select">
                                            <a data-v-6bfc405e="" href="/auth/register" class="btn_join hover">Đăng
                                                ký</a>
                                        </div>
                                    </div>
                                </div>
                                <script>
                                    $(document).ready(() => {
                                        $('#login-form').on('submit', (e) => {
                                            e.preventDefault();
                                            try {
                                                const username = $('input[class=username_input]').val();
                                                const password = $('input[class=password_input]').val();
                                                if (!username || !password) {
                                                    return toastr.error(
                                                        "Vui lòng nhập tài khoản và mật khẩu!",
                                                        "Thất bại!"
                                                    );
                                                }

                                                $.ajax({
                                                    "url": "/auth/login",
                                                    "method": "POST",
                                                    "timeout": 0,
                                                    "headers": {
                                                        "Content-Type": "application/json"
                                                    },
                                                    "data": JSON.stringify({
                                                        "username": username,
                                                        "password": password
                                                    }),
                                                }).done(function (response) {
                                                    if (response.status) {
                                                        console.log(response);
                                                        setTimeout(() => {
                                                            window.location = "/";
                                                        }, 200);
                                                    } else {
                                                        // alert(response.msg);
                                                        return toastr.error(
                                                            response.msg,
                                                            "Thất bại!"
                                                        );
                                                    }
                                                });

                                            } catch (e) {
                                                console.log(e);
                                                alert('Có lỗi xảy ra, vui lòng thử lại!');
                                            }
                                        });
                                    });
                                </script>
                                <% } %>
