                            <script>
                                const refresWallet = () => {
                                    try {
                                        $('.fa-arrows-rotate').addClass('fa-spin');

                                        setTimeout(() => {
                                            $.ajax({
                                                "url": "<%=dataPage.config.MAIN_API%>/api/auth/me",
                                                "method": "GET",
                                                "timeout": 0,
                                                "headers": {
                                                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                                                    "Content-Type": "application/json"
                                                },
                                            }).done(function (response) {
                                                $('.fa-arrows-rotate').removeClass('fa-spin');
                                                if (response.status) {
                                                    const data = response.user;
                                                    $('.current-wallet').html(`${numberWithCommas(response.user.coin)} VND <i class="fa-solid fa-arrows-rotate" style="margin-left: 5px;"></i>`);
                                                } else {
                                                    alert(response.msg);
                                                }
                                            });
                                        }, 1000);

                                    } catch (e) {
                                        console.log(e);
                                        alert("Đã có lỗi xảy ra, vvui lòng thử lại!")
                                    }
                                }
                            </script>
                            <% }else{ %>

                                <div data-v-6bfc405e="" class="login_content">
                                    <div data-v-6bfc405e="" class="username_login">
                                        <form method="GET" action="/" data-v-6bfc405e="" autocomplete="off"
                                            id="login-form">
                                            <div data-v-6bfc405e="" class="form_item">
                                                <input data-v-6bfc405e="" type="text" autocomplete="off" name="username"
