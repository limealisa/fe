    <script>
        var swiperBanner = new Swiper(".mySwiperBanner", {
            effect: 'coverflow',
            grabCursor: true,
            loopFillGroupWithBlank: false,
            centeredSlides: true,
            centeredSlidesBounds: true,
            centeredSlides: true,
            initialSlide: 1,
            coverflowEffect: {
                rotate: 50,
                stretch: 0,
                depth: 100,
                modifier: 1,
                slideShadows: true,
            },
            autoplay: {
                delay: 3000,
                disableOnInteraction: false,
                reverseDirection: false,
            },
            pagination: {
                el: ".swiper-pagination",
                clickable: true,
            },
            on: {
                slideChange: function () {
                    $(".banner_notice").show();
                },
            },
        });

    </script>
    <script>
        $(document).ready(function () {
            $(".fa-eye").click(function () {
                $(this).toggleClass("active")
                var show = $(this).prev("input").attr("type");
                if (show === "password") {
                    $(this).prev("input").attr("type", "text");
                } else {
                    $(this).prev("input").attr("type", "password");
                }
            })
            $(".close-btn").click(function () {
                $(".setting-wrap").removeClass("show");
                $(".reward-wrap").removeClass("show");
            });
            $(".info-wrap .setting-item ").click(function () {
                $(".setting-wrap").addClass("show");
            });
            $(".info-wrap .account-item").click(function () {
                $(".setting-wrap").addClass("show");
            });
            $(".check-reward").click(function () {
                // console.log(2);
                $(".reward-wrap").addClass("show");
            });
            $(".close-reward").click(function () {

                $(".reward-wrap").removeClass("show");
            });

            $(".box-withdraw .hideWidthdraw-1").click(function () {
                $("#withdraw1").css('display', 'block');
                $("#withdraw2").css('display', 'none');
            })
            $(".box-withdraw .hideWidthdraw-2").click(function () {
                $("#withdraw2").css('display', 'block');
                $("#withdraw1").css('display', 'none');
            })
            $(".deposit-content li.bank-item label").click(function () {
                // console.log(1);
                $(".deposit-content li.bank-item label").removeClass("active");
                $(this).addClass("active");
            });
            $(".deposit-content .box .wrap-cash .cash").click(function () {
                // console.log(1);
                $(".deposit-content .box .wrap-cash .cash").removeClass("active");
                $(this).addClass("active");
            });
            $(".close-profile").click(function () {
                $(".profile-user").addClass("hide");
            });
            $(".logined_item.nickname").click(function () {
                $(".profile-user").removeClass("hide");
            });
        });

    </script>

