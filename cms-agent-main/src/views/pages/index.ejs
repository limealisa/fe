    <script>
        const caculatorProfit = () => {
            blockUI(true);
            return new Promise((resolve, reject) => {
                const id = "<%=dataPage.session.user.id;%>";
                $.ajax({
                    "url": '<%=dataPage.config.API_SERVER%>/agency/getProfit/' + id + '?from=' + $('input[name="inputDashboardFrom"]').val() + '&to=' + $('input[name="inputDashboardTo"]').val(),
                    "method": "GET",
                    "timeout": 0,
                    "headers": {
                        "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                    },
                }).then((response) => {
                    blockUI(false);
                    resolve(true);
                    if (response.status) {

                        const dataProfit = response.data;
                        let totalDownlineAgency = 0,
                            totalVolume = 0,
                            totalValidBet = 0,
                            totalDeposit = 0,
                            totalWithdraw = 0,
                            totalUserRef = 0,
                            totalUserNew = 0,
                            totalProfit = 0,
                            totalPlayProfit = 0,
                            totalBalance = 0,
                            totalWinLose = 0,
                            totalSumBalance = 0,
                            totalRefurn = 0,
                            totalIncentive = 0,
                            totalNewDeposit = 0;

                        const dateCheckFrom = moment.utc($('input[name="inputDashboardFrom"]').val(), "DD/MM/YYYY").local().format("DDMMYYYY");
                        const dateCheckTo = moment.utc($('input[name="inputDashboardTo"]').val(), "DD/MM/YYYY").local().format("DDMMYYYY");

                        response.data.forEach((user) => {
                            totalUserRef++;

                            totalBalance += user.userInfo.coin;

                            // caculator downline agency
                            if (user.userInfo.role == "agency") totalDownlineAgency++;
                            // caculator volume
                            user.betRecord.forEach((bet) => {
                                totalVolume += Number(bet.betAmount);
                                totalValidBet += Number(bet.validBetAmount);
                                totalPlayProfit += Number(bet.netPnl);
                            });
                            // caculator user refurn
                            user.betRefurnRecord.forEach((refurn) => {
                                totalRefurn += Number(refurn.amountReturn);
                            });
                            // caculator user incentive
                            user.incentiveRecord.forEach((incentive) => {
                                totalIncentive += Number(incentive.amount);
                            });
                            // caculator deposit
                            user.depositRecord.forEach((deposit) => {
                                if (deposit.is_first) totalNewDeposit++;
                                totalDeposit += Number(deposit.amount);
                            });
                            // caculator withdraw
                            user.withdrawRecord.forEach((withdraw) => {
                                totalWithdraw += Number(withdraw.amount);
                            });
                            totalSumBalance += Number(user.userInfo.coin);
                            // caculator new user register                            
                            const userReg = moment.utc(user.userInfo.createdAt, "YYYY-MM-DDTHH:mm").local().format("DDMMYYYY");
                            if (Number(userReg) >= Number(dateCheckFrom) && Number(userReg) <= Number(dateCheckTo)) {
                                if (user.tag != "root_agency") {
                                    totalUserNew++;
                                }
                            };
                        });

                        totalWinLose = totalDeposit + totalIncentive + totalRefurn - totalBalance - totalWithdraw;

                        totalVolume = totalVolume * 1000;
                        totalValidBet = totalValidBet * 1000;
                        totalProfit = totalDeposit - totalWithdraw - totalIncentive - totalRefurn;
                        totalPlayProfit = totalPlayProfit * 1000;
                        totalUserRef = totalUserRef - response.totalUsers.length;

                        $('#countDownlineAgency').html(numberWithCommas(totalDownlineAgency));
                        $('#countRefUser').html(numberWithCommas(totalUserRef));
                        $('#countUserNew').html(numberWithCommas(totalUserNew));
                        $('#totalVolume').html(numberWithCommas(totalVolume));
                        $('#totalValidBet').html(numberWithCommas(totalValidBet));
                        $('#totalDeposit').html(numberWithCommas(totalDeposit));
                        $('#totalWithdraw').html(numberWithCommas(totalWithdraw));
                        $('#countProfit').html(numberWithCommas(totalProfit));
                        $('#countPlayProfit').html(numberWithCommas(totalWinLose));
                        $('#countSumBalance').html(numberWithCommas(totalSumBalance));
                        $('#dashboard-total-users').html(numberWithCommas(response.totalUsers.length));
                        $('#totalRefurn').html(numberWithCommas(totalRefurn));
                        $('#totalIncentive').html(numberWithCommas(totalIncentive));
                        $('#totalNewDeposit').html(numberWithCommas(totalNewDeposit));

                    } else {
                        toastr.error(
                            response.msg,
                            "Error!"
                        );
                    }
                }).catch((err) => {
                    blockUI(false);
                    resolve(true);
                    console.log(err);
                    toastr.error(
                        err.responseJSON.msg,
                        "Error!"
                    );
                });
            });
        }



        $(document).ready(() => {
            // Set default value
            $('input[name="inputDashboardFrom"]').val(moment().format("DD/MM/YYYY"));
            $('input[name="inputDashboardTo"]').val(moment().format("DD/MM/YYYY"));

            // Date Picker  
            $('input[name="inputDashboardFrom"]').datepicker({
                language: 'vi',
                autoclose: true,
                todayHighlight: true,
            });
            $('input[name="inputDashboardTo"]').datepicker({
                language: 'vi',
                autoclose: true,
                todayHighlight: true,
            });

            blockUI(true);
            caculatorProfit().then((success) => blockUI(false));
        });
    </script>



