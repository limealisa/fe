        const updateUser = (id) => {
            const name = $('#update-name').val();
            const username = $('#update-username').val();
            const code = $('#update-code').val();
            const email = $('#update-email').val();
            const phone = $('#update-phone').val();
            const coin = $('#update-coin').val();
            const status = $('#update-status').val();
            const verify = $('#update-verify').val();
            const role = $('#update-role').val();

            if (!name || !username || !code || !email || !phone || !coin || !role) {
                toastr.error(
                    "Vui lòng điền đầy đủ thông tin!",
                    "Error!"
                );
                return;
            }

            if (Number(coin) < 0) {
                toastr.error(
                    "Số dư không hợp lệ!",
                    "Error!"
                );
                return;
            }

            $.ajax({
                "url": "<%=dataPage.config.API_SERVER%>/agency/update/" + id,
                "method": "POST",
                "timeout": 0,
                "headers": {
                    "Content-Type": "application/json",
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                },
                "data": JSON.stringify({
                    name,
                    username,
                    code,
                    email,
                    phone,
                    coin: Number(coin),
                    status,
                    verify: JSON.parse(verify),
                    role
                }),
            }).done(function (response) {
                if (response.status) {
                    toastr.success(
                        response.msg,
                        "Success!"
                    );
                    setTimeout(() => {
                        window.location = "";
                    }, 700);
                } else {
                    toastr.error(
                        response.msg,
                        "Error!"
                    );
                }
            });
        }

        const makeTableProfit = (boolean) => {
            if (!boolean) {
                $("#table-user-profit-container-main").html(``);
                return;
            }
            $("#table-user-profit-container-main").html(`
                <table id="table-user-profit-container" class="table customize-table table-bordered mb-10 v-middle">
                    <thead class="bg-primary text-white">
                    </thead>
                    <tbody id="table-user-profit">
                    </tbody>
                </table>
            `);
        }

        // lấy doanh thu đại lý và người chơi cấp dưới
        const showFormProfit = (id, name) => {
            $('.modal-backdrop').remove();
            $("#userInfo-profit-modal-username").html(name);
            $("#userInfo-profit-modal-btn-check-profit").attr("data-id", id);
            
            $(document).ready(() => {
                // Set default value
                $('input[name="inputProfitFrom"]').val(moment().format("DD/MM/YYYY"));
                $('input[name="inputProfitTo"]').val(moment().format("DD/MM/YYYY"));
                // Date Picker  
                $('input[name="inputProfitFrom"]').datepicker({
                    language: 'vi',
                    autoclose: true,
                    todayHighlight: true,
                });
                $('input[name="inputProfitTo"]').datepicker({
                    language: 'vi',
                    autoclose: true,
                    todayHighlight: true,
                });
            });
            $('#totalRootAgentUser').html(numberWithCommas(0));
            $('#totalDeposit').html(numberWithCommas(0));
            $('#totalWithdraw').html(numberWithCommas(0));
            $('#totalProfit').html(numberWithCommas(0));
            $('#totalValidBet').html(numberWithCommas(0));
            $('#totalNetPnl').html(numberWithCommas(0));
            $('#totalWin').html(numberWithCommas(0));
            $('#totalLose').html(numberWithCommas(0));
            $('#totalIncentive').html(numberWithCommas(0));
            $('#totalChildAgent').html(numberWithCommas(0));
            $('#totalChildAgentUser').html(numberWithCommas(0));
            $('#totalNewRefUser').html(numberWithCommas(0));
            $('#totalNewFirstDeposit').html(numberWithCommas(0));
            $('#totalDepositCount').html(numberWithCommas(0));
            $('#totalWithdrawCount').html(numberWithCommas(0));

            
            $('#table-user-profit').html(``);
        
            $('#userInfo-update-modal').modal('toggle');
            $('#userInfo-profit-modal').modal('toggle');
            getProfitAgency();
        }
    

        const getProfitAgency = () => {
            makeTableProfit(false);
            makeTableProfit(true);

            blockUI(true);
            const id = $("#userInfo-profit-modal-btn-check-profit").attr("data-id");

            $.ajax({
                "url": '<%=dataPage.config.API_SERVER%>/agency/getProfit/' + id + '?from=' + $('input[name="inputProfitFrom"]').val() + '&to=' + $('input[name="inputProfitTo"]').val(),
                "method": "GET",
                "timeout": 0,
                "headers": {
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                },
            }).then((response) => {
                blockUI(false);
                if (response.status) {
                    // $('#tableProfitUser').html(``);
                    
                    const dataUserProfit = response.data;
                    const rootAgentUser = response.totalUsers;
                    let 
                    totalRootAgentUser = 
                    totalBalance = 

                    totalBet = 
                    totalValidBet =  

                    totalDeposit =  
                    totalWithdraw = 
                    totalDepositCount =
                    totalWithdrawCount =
                    totalProfit = 

                    totalNetPnl = 
                    totalWin =
                    totalLose = 
                    totalWinLose = 
                    
                    totalIncentive =
                    totalIncentiveDonate =
                    totalRefurn = 

                    totalChildAgent = 
                    totalChildAgentUser = 
                    totalNewRefUser = 

                    totalNewFirstDeposit =
                    0;


                    // Thống kê số liệu doanh số

                    const dateCheckFrom = moment.utc($('input[name="inputProfitFrom"]').val(), "DD/MM/YYYY").local().format("DDMMYYYY");
                    const dateCheckTo = moment.utc($('input[name="inputProfitTo"]').val(), "DD/MM/YYYY").local().format("DDMMYYYY");

                    dataUserProfit.forEach((user) => {
                        // caculator user totalBalance
                        totalBalance += user.userInfo.coin;

                        // caculator volume
                        user.betRecord.forEach((bet) => {
                            totalBet += Number(bet.betAmount) * 1000;
                            totalValidBet += Number(bet.validBetAmount) * 1000;
                            totalNetPnl += Number(bet.netPnl) * 1000;
                            (Number(bet.netPnl) > 0) ? totalWin += Number(bet.netPnl) * 1000: totalLose += Number(bet.netPnl) * 1000;
                        });
                        // caculator user refurn
                        user.betRefurnRecord.forEach((refurn) => {
                            totalRefurn += Number(refurn.amountReturn);
                        });
                        // caculator user incentive
                        user.incentiveRecord.forEach((incentive) => {
                            totalIncentive += Number(incentive.amount);
                        });
                        // caculator user incentive donate
                        user.incentiveDonateRecord.forEach((incentive) => {
                            totalIncentiveDonate += Number(incentive.amount);
                        });
                        // caculator deposit
                        user.depositRecord.forEach((deposit) => {
                            if (deposit.is_first) totalNewFirstDeposit++;
                            totalDepositCount++;
                            totalDeposit += Number(deposit.amount);
                        });

                        // caculator withdraw
                        user.withdrawRecord.forEach((withdraw) => {
                            totalWithdrawCount++;
                            totalWithdraw += Number(withdraw.amount);
                        });

                        if (user.tag == "root_agency") {};
                        if (user.tag == "root_agency_user") totalRootAgentUser++;
                        if (user.tag == "children_agency") totalChildAgent++;
                        if (user.tag == "children_agency_user") totalChildAgentUser++;
                        
                    
                        const userReg = moment.utc(user.userInfo.createdAt, "YYYY-MM-DDTHH:mm").local().format("DDMMYYYY");
                        if (Number(userReg) >= Number(dateCheckFrom) && Number(userReg) <= Number(dateCheckTo)) {
                            if (user.tag != "root_agency") {
                                totalNewRefUser++;
                            }
                        };
                    });

                    totalProfit = totalDeposit - totalWithdraw - totalRefurn - totalIncentive;
                    totalWinLose = totalDeposit + totalIncentive + totalRefurn - totalBalance - totalWithdraw;
                    totalValidBet = totalValidBet;

                    $('#totalRootAgentUser').html(numberWithCommas(totalRootAgentUser));
                    $('#totalDeposit').html(numberWithCommas(totalDeposit));
                    $('#totalWithdraw').html(numberWithCommas(totalWithdraw));
                    $('#totalProfit').html(numberWithCommas(totalDeposit - totalWithdraw));
                    $('#totalValidBet').html(numberWithCommas(totalValidBet));
                    // $('#totalNetPnl').html(numberWithCommas(totalNetPnl));
                    $('#totalWin').html(numberWithCommas(totalWin));
                    $('#totalLose').html(numberWithCommas(totalLose));
                    $('#totalRefurn').html(numberWithCommas(totalRefurn));
                    $('#totalIncentive').html(numberWithCommas(totalIncentive));
                    $('#totalIncentiveDonate').html(numberWithCommas(totalIncentiveDonate));
                    $('#totalChildAgent').html(numberWithCommas(totalChildAgent));
                    $('#totalChildAgentUser').html(numberWithCommas(totalChildAgentUser));
                    $('#totalNewRefUser').html(numberWithCommas(totalNewRefUser));
                    $('#totalNewFirstDeposit').html(numberWithCommas(totalNewFirstDeposit));

                    $('#totalNetPnl').html(numberWithCommas(totalWinLose));

                    $('#totalDepositCount').html(numberWithCommas(totalDepositCount));
                    $('#totalWithdrawCount').html(numberWithCommas(totalWithdrawCount));

                    // Thống kê số liệu doanh số bằng bảng

