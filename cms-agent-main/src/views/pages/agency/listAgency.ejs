                    //$('#update-phone').val(`xxxxxxxxxxxxxxx`);
                    $('#update-phone').val(`xxxxxxxxxxxxxxx`);
                    $('#update-coin').val(response.data.coin);
                    //$('#update-status').val();
                    //$('#update-varify').val();

                    if (response.data.status == "active") {
