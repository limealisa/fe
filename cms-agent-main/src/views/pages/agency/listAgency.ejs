    <script>
        $(document).ready(() => {
            const datatable = $('#table-container').DataTable({
                paging: false,
                searching: false,
                info: false,
                order: [[1, 'desc']],
                scrollCollapse: true,
                scrollY: '800px',
                // autoWidth: false,
                columns: [
                    { title: "Hành_Động", width: '550px' },
                    { title: "Cấp_Đại_Lý", width: '50px' },
                    { title: "#UID", width: '50px' },
                    { title: "Tên_Đại_Lý", width: '50px' },
                    { title: "Tên_Đăng_Nhập", width: '30px' },
                    { title: "Mã_Đại_Lý", width: '30px' },
                    { title: "Số_Dư", width: '50px' },
                    { title: "Số_Lần_Nạp", width: '30px' },
                    { title: "Số_Lần_Rút", width: '30px' },
                    { title: "Tiền_Nạp", width: '50px' },
                    { title: "Tiền_Rút", width: '30px' },
                    { title: "Cược_Hợp_Lệ", width: '30px' },
                    { title: "Thắng_Thua", width: '100px' },
                    { title: "Hoàn_Trả" },
                    { title: "Khuyễn_Mãi" },
                    { title: "Khuyễn_Mãi_Tặng"},
                    { title: "Trạng_Thái", width: '550px' },
                    { title: "Ngân_Hàng", width: '550px' },
                    { title: "ĐK_vòng_cược", width: '550px' },
                    { title: "Ngày_Đăng_Ký", width: '550px' },
                    // { title: "User_Agent", width: '550px' },
                    { title: "IP_Gần_nhất", width: '550px' },
                ],
                responsive: true
            });
        });
        
        const phantrang = Pagination('<%=dataApi.page%>', '<%=dataApi.total%>', '<%=dataApi.kmess%>');
        const urlSearchParams = new URLSearchParams(window.location.search);
        urlSearchParams.delete("page");
        urlSearchParams.delete("limit");
        let phantrangBody = '';
        phantrang.forEach((page) => {
            $("#phantrangUser").html(phantrangBody);
            let active = ('<%=dataApi.page%>' == page) ? "active" : "";
            const urlToPage = (page !== "...") ? `/agency?page=${page}&limit=<%=dataApi.kmess%>&${urlSearchParams.toString()}` : `javascript:void(0)`;
            phantrangBody += `
                <li class="page-item ${active}">
                    <a class="page-link" href="${urlToPage}"><b>${page}</b></a>
                </li>
            `;
            $("#phantrangUser").html(phantrangBody);
        });

        const deleteDailyConfirm = (id) => {
            cuteAlert({
                type: "question",
                title: "Hành Động",
                message: "Bạn có muốn xóa nó không?",
                confirmText: "Đồng ý",
                cancelText: "Hủy"
            }).then((e) => {
                if (e == 'confirm') {
                    return;
                    $.ajax({
                        "url": '<%=dataPage.config.API_SERVER%>/user/delete/' + id,
                        "method": "GET",
                        "timeout": 0,
                        "headers": {
                            "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                        },
                    }).then((response) => {
                        if (response.status) {
                            toastr.success(
                                "Thành công.",
                                "Success!"
                            );
                            setTimeout(() => {
                                window.location = "";
                            }, 700);
                        } else {
                            toastr.error(
                                response.msg,
                                "Error!"
                            );
                        }
                    }).catch((err) => {
                        console.log(err);
                        toastr.error(
                            err.responseJSON.msg,
                            "Error!"
                        );
                    });

                }
            });
        }

        const showFormUpdateUser = (id, agencyId) => {
            $.ajax({
                "url": '<%=dataPage.config.API_SERVER%>/agency/agency-info/' + id,
                "method": "GET",
                "timeout": 0,
                "headers": {
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                },
            }).then((response) => {
                if (response.status) {
                    $('#elementModal').html(`
                    <div class="modal fade" id="userInfo-update-modal" tabindex="-1" aria-labelledby="exampleModalLabel1">
                        <div class="modal-dialog modal-md" role="document">
                            <div class="modal-content">
                                <div class="modal-header d-flex align-items-center">
                                    <h4 class="modal-title" id="exampleModalLabel1">
                                        Cập nhật đại lý - ${response.data.username}
                                    </h4>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
