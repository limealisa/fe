                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    `);

                    $('input[name="from"]').val(moment().format("DD/MM/YYYY"));
                    $('input[name="to"]').val(moment().format("DD/MM/YYYY"));

                    // Date Picker  
                    $('input[name="from"]').datepicker({
                        language: 'vi',
                        autoclose: true,
                        todayHighlight: true,
                    });
                    $('input[name="to"]').datepicker({
                        language: 'vi',
                        autoclose: true,
                        todayHighlight: true,
                    });

                    // bind event
                    $("#update-coin").on("keyup", function () {
                        $("#update-coin").val(numberWithCommas(getOnlyNumberInString($("#update-coin").val())));
                    });
                    $("#update-withdraw-condition-coin-numb").on("keyup", function () {
                        $("#update-withdraw-condition-coin-numb").val(numberWithCommas(getOnlyNumberInString($("#update-withdraw-condition-coin-numb").val())));
                    });

                    $('#update-name').val(response.data.name);
                    $('#update-username').val(response.data.username);
                    $('#update-email').val("****************" || response.data.email);
                    $('#update-phone').val("****************" || response.data.phone);
                    $('#update-coin').val(numberWithCommas(response.data.coin));
                    //$('#update-status').val();
                    //$('#update-varify').val();

                    $('#update-withdraw-condition-bet-numb').val(numberWithCommas(response.data.WithdrawConditionInfo[0].minimumNumbOfBet));
                    $('#update-withdraw-condition-coin-numb').val(numberWithCommas(response.data.WithdrawConditionInfo[0].totalMinimumBetAmount));

                    if (response.data.status == "active") {
                        $('#update-status').append(`<option value="active">Hoạt động</option>`);
                        $('#update-status').append(`<option value="blocked">Bị khóa</option>`);
                    } else {
                        $('#update-status').append(`<option value="blocked">Bị khóa</option>`);
                        $('#update-status').append(`<option value="active">Hoạt động</option>`);
                    }

                    if (response.data.verify) {
                        $('#update-verify').append(`<option value="true">Đã xác minh</option>`);
                        $('#update-verify').append(`<option value="false">Chưa xác minh</option>`);
                    } else {
                        $('#update-verify').append(`<option value="false">Chưa xác minh</option>`);
                        $('#update-verify').append(`<option value="true">Đã xác minh</option>`);
                    }

                    $('#update-role').append(`<option value="agency">Đại lý</option>`);
                    $('#update-role').append(`<option value="user">Người chơi</option>`);

                    // getGameWallet(response.data.username);
                    getProfitUser(id);

                    offCanvas($("#offcanvas-container"));
                } else {
                    toastr.error(
                        response.msg,
                        "Error!"
                    );
                }
            }).catch((err) => {
                console.log(err);
                toastr.error(
                    err.responseJSON.msg,
                    "Error!"
                );
            });
        }

        const getProfitUser = (id) => {
            const from = $('input[name="from"]').val();
            const to = $('input[name="to"]').val();
            blockUI(true);
            $.ajax({
                "url": '<%=dataPage.config.API_SERVER%>/user/user-profit/' + id + '?from='+from+'&to='+to,
                "method": "GET",
                "timeout": 0,
                "headers": {
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                },
            }).then((response) => {
                if (response.status) {
                    const data = response.data;
                    let totalDeposit = 0;
                    let totalWithdraw = 0;
                    let totalDepositCount = 0;
                    let totalWithdrawCount = 0;
                    let totalRefurn = 0;
                    let totalIncentive = 0;
                    let totalProfit = 0;
                    let totalBetValid = 0;
                    let totalWin = 0;
                    let totalLose = 0;

                    data.finan.map((row) => {
                        if (row.type == "recharge" && row.status == "success") {
                            totalDeposit += row.amount;
                            totalDepositCount++;
                        };
                        if (row.type == "cashout" && row.status == "success") {
                            totalWithdraw += row.amount;
                            totalWithdrawCount++;
                        }
                    });

                    data.bet.map((row) => {
                        totalBetValid += row.validBetAmount * 1000;
                        if (row.netPnl > 0) totalWin += row.netPnl * 1000;
                        if (row.netPnl < 0) totalLose += row.netPnl * 1000;
                    });

                    data.refurn.map((row) => {
                        totalRefurn += row.amountReturn;
                    });

                    totalProfit = totalDeposit - totalWithdraw - totalRefurn;

                    $("#total-deposit").html(numberWithCommas(totalDeposit));
                    $("#total-witdraw").html(numberWithCommas(totalWithdraw));
                    $("#total-deposit-count").html(numberWithCommas(totalDepositCount));
                    $("#total-witdraw-count").html(numberWithCommas(totalWithdrawCount));
                    
                    $("#total-profit").html(numberWithCommas(totalProfit));
                    $("#total-bet-valid").html(numberWithCommas(totalBetValid));
                    $("#total-win").html(numberWithCommas(totalWin));
                    $("#total-lose").html(numberWithCommas(totalLose));
                }else {
                    console.log(response);
                    toastr.error(
                        response.msg,
                        "Error!"
                    );
                }
                blockUI(false);
            });
        }
        

        const updateUser = (id) => {
            const name = $('#update-name').val();
            const username = $('#update-username').val();
            const email = $('#update-email').val();
            const phone = $('#update-phone').val();
            const coin = $('#update-coin').val();
            const status = $('#update-status').val();
            const verify = $('#update-verify').val();
            const role = $('#update-role').val();

            if (!name || !username || !email || !phone || !coin || !role) {
                toastr.error(
                    "Vui lòng điền đầy đủ thông tin!",
                    "Error!"
                );
                return;
            }

            if (Number(coin) < 0) {
                toastr.error(
                    "Số dư không hợp lệ!",
                    "Error!"
                );
                return;
            }

            $.ajax({
                "url": "<%=dataPage.config.API_SERVER%>/user/update/" + id,
                "method": "POST",
                "timeout": 0,
                "headers": {
                    "Content-Type": "application/json",
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                },
                "data": JSON.stringify({
                    name,
                    username,
                    email,
                    phone,
                    coin: Number(coin),
                    status,
                    verify: JSON.parse(verify),
                    role
                }),
            }).done(function (response) {
                if (response.status) {
                    toastr.success(
                        response.msg,
                        "Success!"
                    );
                    setTimeout(() => {
                        window.location = "";
                    }, 700);
                } else {
                    toastr.error(
                        response.msg,
                        "Error!"
                    );
                }
            });
        }
    </script>
    <%- include('../../includes/footer') %>