    <script>
        $(document).ready(() => {
            const datatable = $('#table-container').DataTable({
                paging: false,
                searching: false,
                info: false,
                order: [[1, 'desc']],
                scrollCollapse: true,
                scrollY: '800px',
                // autoWidth: false,
                columns: [
                    { title: "Hành_Động", width: '550px' },
                    { title: "#UID", width: '50px' },
                    { title: "Tên_Người_Chơi", width: '50px' },
                    { title: "Tên_Đăng_Nhập", width: '30px' },
                    { title: "Số_Dư", width: '50px' },
                    { title: "Số_Lần_Nạp", width: '30px' },
                    { title: "Số_Lần_Rút", width: '30px' },
                    { title: "Tiền_Nạp", width: '50px' },
                    { title: "Tiền_Rút", width: '30px' },
                    { title: "Cược_Hợp_Lệ", width: '30px' },
                    { title: "Thắng_Thua", width: '100px' },
                    { title: "Hoàn_Trả" },
                    { title: "Khuyễn_Mãi" },
                    { title: "Khuyễn_Mãi_Tặng"},
                    { title: "Trạng_Thái", width: '550px' },
                    { title: "Ngân_Hàng", width: '550px' },
                    { title: "ĐK_vòng_cược", width: '550px' },
                    { title: "Ngày_Đăng_Ký", width: '550px' },
                    // { title: "User_Agent", width: '550px' },
                    { title: "IP_Gần_nhất", width: '550px' },
                ],
                responsive: true
            });
        });

        const urlSearchParams = new URLSearchParams(window.location.search);
        urlSearchParams.delete("page");
        urlSearchParams.delete("limit");
        const phantrang = Pagination('<%=dataApi.page%>', '<%=dataApi.total%>', '<%=dataApi.kmess%>');

        let phantrangBody = '';
        phantrang.forEach((page) => {
            $("#phantrangUser").html(phantrangBody);
            let active = ('<%=dataApi.page%>' == page) ? "active" : "";
            const urlToPage = (page !== "...") ? `/user?page=${page}&limit=<%=dataApi.kmess%>&${urlSearchParams.toString()}` : `javascript:void(0)`;
            phantrangBody += `
                <li class="page-item ${active}">
                    <a class="page-link" href="${urlToPage}"><b>${page}</b></a>
                </li>
            `;
            $("#phantrangUser").html(phantrangBody);
        });

        const deleteDailyConfirm = (id) => {
            cuteAlert({
                type: "question",
                title: "Hành Động",
                message: "Bạn có muốn xóa nó không?",
                confirmText: "Đồng ý",
                cancelText: "Hủy"
            }).then((e) => {
                if (e == 'confirm') {
                    $.ajax({
                        "url": '<%=dataPage.config.API_SERVER%>/user/delete/' + id,
                        "method": "GET",
                        "timeout": 0,
                        "headers": {
                            "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                        },
                    }).then((response) => {
                        if (response.status) {
                            toastr.success(
                                "Thành công.",
                                "Success!"
                            );
                            setTimeout(() => {
                                window.location = "";
                            }, 700);
                        } else {
                            toastr.error(
                                response.msg,
                                "Error!"
                            );
                        }
                    }).catch((err) => {
                        console.log(err);
                        toastr.error(
                            err.responseJSON.msg,
                            "Error!"
                        );
                    });

                }
            });
        }

