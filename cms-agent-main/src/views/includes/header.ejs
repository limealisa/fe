    <!-- End Modal Change Password-->
    <script>
        $('form[name="agentChangePassword2Form"]').on('submit', (e) => {
            e.preventDefault(); // Now nothing will happen
            const notifyElement = $("#notifyElement2");
            const dailyOldPassword = $("input[name=agentOldPassword2]").val();
            const dailyPassword = $("input[name=agentNewPassword2]").val();
            const dailyPasswordConfirm = $("input[name=agentConfirmPassword2]").val();

            if (!dailyOldPassword ||
                !dailyPassword ||
                !dailyPasswordConfirm) {
                notifyElement.html(`<div class="alert alert-danger alert-dismissible bg-danger text-white border-0 fade show" role="alert">
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                            Vui lòng điền đầy đủ thông tin.
                        </div>`);
                return;
            }

            if (dailyPassword !== dailyPasswordConfirm) {
                notifyElement.html(`<div class="alert alert-danger alert-dismissible bg-danger text-white border-0 fade show" role="alert">
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                            2 mật khẩu không khớp.
                        </div>`);
                return;
            }

            $.ajax({
                "url": `<%=dataPage.config.API_SERVER%>/auth/change-password-security`,
                "method": "POST",
                "timeout": 0,
                "headers": {
                    "Authorization": "Bearer <%=dataPage.session.accessToken%>",
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                "data": {
                    oldPassword: dailyOldPassword,
                    newPassword: dailyPassword,
                    newPasswordConfirm: dailyPasswordConfirm
                }
            }).then((response) => {
                if (response.status) {
                    notifyElement.html(`<div class="alert alert-danger alert-dismissible bg-success text-white border-0 fade show" role="alert">
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                                Đổi mật khẩu thành công!
                            </div>`);
                    return;
                } else {
                    notifyElement.html(`<div class="alert alert-danger alert-dismissible bg-danger text-white border-0 fade show" role="alert">
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                                ${response.msg}
                            </div>`);
                    return;
                }
            }).catch((err) => {
                console.log(err);
                notifyElement.html(`<div class="alert alert-danger alert-dismissible bg-danger text-white border-0 fade show" role="alert">
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                                ${err.statusText}
                            </div>`);
                return;
            });
        })
    </script>

